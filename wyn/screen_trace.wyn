-- Screen-space visibility against the shared G-buffer. No lighting or BVH state.
import "camera"
import "math"
import "render_types"

module screen_trace = {

  type settings = { steps: i32, refinements: i32, start: f32, distance: f32, thickness: f32 }

  def position(scene: render_target<gbuffer>, resolution: vec3f32, camera: orbit,
               xy: vec2i32) vec3f32 =
    world_from_depth(resolution, @[f32(xy.x) + 0.5, resolution.y - f32(xy.y) - 0.5],
                     camera, target_load(scene, xy, 0u32).depth)

  def depth(scene: render_target<gbuffer>, resolution: vec3f32, xy: vec2i32) f32 =
    target_load(scene, @[clampi(xy.x, 0, i32(resolution.x) - 1),
                         clampi(xy.y, 0, i32(resolution.y) - 1)], 0u32).depth

  -- Point + bilinear depth, following the author's published raymarch.hlsl:
  -- https://gist.github.com/h3r2tic/9c8356bdaefbe80b1a22ae0aaee192db
  -- Its conservative test uses the farther depth; thickness uses the nearer one.
  -- This is stricter than the average-depth description in the local talk notes.
  def depth_delta(scene: render_target<gbuffer>, resolution: vec3f32, camera: orbit,
                  p: vec3f32) (f32, f32, bool) =
    let (pixel, valid) = project_pixel(p, resolution, camera) in
    if !valid then (0.0, 0.0, false)
    else
      let cell = @[i32(f32.floor(pixel.x - 0.5)), i32(f32.floor(pixel.y - 0.5))]
      let f = pixel - @[f32(cell.x) + 0.5, f32(cell.y) + 0.5]
      let d00 = depth(scene, resolution, cell)
      let d10 = depth(scene, resolution, cell + @[1, 0])
      let d01 = depth(scene, resolution, cell + @[0, 1])
      let d11 = depth(scene, resolution, cell + @[1, 1])
      let smooth = linear_depth((d00 * (1.0 - f.x) + d10 * f.x) * (1.0 - f.y)
                              + (d01 * (1.0 - f.x) + d11 * f.x) * f.y)
      let point = linear_depth(depth(scene, resolution, @[i32(pixel.x), i32(pixel.y)]))
      let c = world_to_clip(p, resolution, camera)
      let ray = linear_depth(c.z / c.w) in
      (f32.max(point, smooth) + 0.002 - ray, ray - f32.min(point, smooth), true)

  -- March short detail densely, then wider intervals. On a crossing refine before
  -- the thickness check, so stepping behind a thin surface does not discard it.
  -- On failure the caller chooses the fallback representation.
  def trace(scene: render_target<gbuffer>, resolution: vec3f32, camera: orbit,
            ro: vec3f32, rd: vec3f32, options: settings) (vec2i32, bool) =
    let (low, high, found, _active) =
      loop (low, high, found, active) = (0.0, 0.0, false, true) for k < options.steps do
        if !active then (low, high, found, false)
        else
          let u = f32(k + 1) / f32(options.steps)
          let t = options.start + options.distance * u * u
          let (delta, _penetration, valid) = depth_delta(scene, resolution, camera, ro + rd * t) in
          if !valid then (low, t, false, false)
          else if delta < 0.0 then (low, t, true, false)
          else (t, t, false, true)
    in if !found then (@[0, 0], false)
    else
      let (_a, b) = loop (a, b) = (low, high) for _k < options.refinements do
        let t = (a + b) * 0.5
        let (delta, _penetration, valid) = depth_delta(scene, resolution, camera, ro + rd * t) in
        if valid && delta < 0.0 then (a, t) else (t, b)
      let p = ro + rd * b
      let (_delta, penetration, valid) = depth_delta(scene, resolution, camera, p)
      let (pixel, _visible) = project_pixel(p, resolution, camera)
      let xy = @[i32(pixel.x), i32(pixel.y)]
      let g = target_load(scene, xy, 0u32) in
      (xy, valid && penetration < options.thickness && g.albedo.w > 0.5
             && dot(octahedral.decode(g.normal), rd) < -0.01)
}
