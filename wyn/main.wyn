-- tiny porto — root shader module.
--
-- Ground painting as an ordered list of parametric items, evaluated per fragment
-- as an analytic SDF composite (no geometry above the ground plane). Three tools:
--   tool 0 / kind 1  water    — big-radius capsule chain (one outline per stroke)
--   tool 1 / kind 2  fence    — thin capsule chain along a curve
--   tool 2 / kind 3  building — fixed-size rectangle plunked on click
-- Strokes capture control points online (Reumann-Witkam) and render through a
-- Catmull-Rom curve. Z-order is order of addition.
--
-- Ground ribbons and rounded-box props fill a shared G-buffer. Deferred lighting
-- combines that surface data with sunlight, ambient occlusion, water, and sky.
-- Sett placement and materials live in bricks.wyn; curve math comes from wyn/curves.
--
-- Idiom: root does `open f32`; library modules pulled in via bare `import`.

open f32
import "math"
import "camera"
import "shade"
import "paint"
import "input"
import "bricks"
import "walls"
import "shadow"
import "pkg:gtao"
import "clouds"
import "hiz"
import "water"
import "render_types"
import "pkg:gfx"

-- Per-frame globals: one std140 #[uniform] block the host fills once and every
-- entry binds at (set=1, binding=0). Continuous state lives here; discrete input
-- (keys, mouse buttons, cursor motion, wheel) arrives as the `events` stream that
-- update_world folds. Members:
--   resolution  (width, height, aspect)
--   mods        LIVE modifier mask at frame time (bit0 shift, 1 ctrl, 2 alt, 3
--               super) — the "held right now" query, distinct from an event's own
--               captured mods.
--   cam_*       the orbit camera the host drives (target, azimuth, elevation,
--               distance) — see camera.orbit.
type frame_globals = {
  resolution: vec3f32,
  mods: u32,
  cam_target: vec3f32,
  cam_az: f32,
  cam_elev: f32,
  cam_dist: f32,
  time: f32,          -- seconds since start; drives the water animation
}

-- The orbit camera the host drives, unpacked from the frame block. Built locally
-- wherever the camera is used (kept out of `map` lambdas as an outer capture).
def camera_from_frame(frame: frame_globals) orbit =
  { target = frame.cam_target, az = frame.cam_az, elev = frame.cam_elev, dist = frame.cam_dist }

-- Persistent painter state: UI, control points, paint items, and stroke capture.
-- Input helpers decode events; update_world folds them into the next state.
type world = { ui: []f32, points: []vec2f32, items: []vec4f32, head: []f32 }

-- The painted geometry the render passes read: the control points and the packed
-- items — the read-only geometry view of the `world`. `cull_props` and `resolve_fragment`
-- bundle their two storage inputs into this to evaluate the canal SDF against one
-- value.
type painted = { points: []vec2f32, items: []vec4f32 }

-- The unified graphics vocabulary treats indirect commands as ordinary values.
-- These fields are the WebGPU non-indexed indirect-draw ABI, but their data flow
-- and production remain wholly inside Wyn.
type draw_command = {
  vertex_count: u32,
  instance_count: u32,
  first_vertex: u32,
  first_instance: u32,
}

type scene_geometry = {
  geom_pos: []vec4f32,
  geom_nrm: []vec4f32,
  draw: draw_command,
}

type visibility = {
  prop_inst: []prop,
  draw: draw_command,
}

type lighting_inputs = {
  scene: render_target<gbuffer>,
  sun_depth: render_target<f32>,
  ao_work: []vec4f32,
}

def append_captured_points(previous_points: []vec2f32, existing_point_count: i32,
                           capture: stroke_capture) []vec2f32 =
  map(|i| if i >= existing_point_count && i - existing_point_count < capture.emitted_count
          then capture.emitted[i - existing_point_count] else previous_points[i], iota(POINTS_CAP))

def create_or_extend_item(previous_items: []vec4f32, head: stroke_head,
                          capture: stroke_capture, tool: f32) []vec4f32 =
  map(|i| if capture.pressed > 0.5 && i == head.item_count then
            pack_paint_item({ kind = item_kind_for_tool(tool), point_start = head.point_count,
                              point_count = capture.emitted_count, param = stroke_half_width(tool) })
          else if capture.pressed < 0.5 && capture.emitted_count > 0i32 && i == head.item_count - 1i32 then
            let item = paint_item_from_packed(previous_items[i]) in
            pack_paint_item({ kind = item.kind, point_start = item.point_start,
                              point_count = item.point_count + capture.emitted_count, param = item.param })
          else previous_items[i], iota(ITEMS_CAP))

def ground_positions(items: []vec4f32, points: []vec2f32) []vec4f32 =
  map(|s| ground_pos(s, items, points), iota(TESS_CAP))

def ground_normals(items: []vec4f32, points: []vec2f32) []vec4f32 =
  map(|s| ground_nrm(s, items, points), iota(TESS_CAP))

def ground_draw: draw_command =
  { vertex_count = u32(TESS_CAP), instance_count = 1u32,
    first_vertex = 0u32, first_instance = 0u32 }

-- Apply UI shortcuts, capture stroke points, and create or extend the current item.
def update_world(frame: frame_globals, events: []vec4f32, previous_world: world) world =
  let ui = ui_state_from_buffer(previous_world.ui)
  let head = stroke_head_from_buffer(previous_world.head)
  -- Use one tool for the whole batch: UI and stroke events are folded separately,
  -- so a tool change takes effect on the next frame.
  let next_ui = apply_ui_shortcuts(ui, events)
  let capture = capture_stroke_points(
    head, events, frame.resolution, camera_from_frame(frame), is_building(ui.tool)) in
  { ui = pack_ui_state(next_ui),
    points = append_captured_points(previous_world.points, head.point_count, capture),
    items = create_or_extend_item(previous_world.items, head, capture, ui.tool),
    head = pack_stroke_head(record_capture_progress(head, capture)) }

-- Ground geometry derived from the (previous) world: two parallel vertex streams
-- (geom_pos = pos.xyz+kind, geom_nrm = nrm.xyz+attr) over the tessellation domain,
-- plus the non-indexed ground draw args. Tessellates the PREVIOUS points/items, so
-- rendered geometry lags input by one frame (imperceptible).
def tessellate_ground(painted_world: world) scene_geometry =
  { geom_pos = ground_positions(painted_world.items, painted_world.points),
    geom_nrm = ground_normals(painted_world.items, painted_world.points),
    draw = ground_draw }

------------------------------------------------------------
-- Coarse-depth occlusion. Each tile stores the nearest surface depth from the
-- previous frame. Prop visibility compares projected candidates with those tiles.
-- OCC_TILE and the coarse-grid dimensions live in hiz.wyn.
------------------------------------------------------------

-- In the unified pipeline model the scene and sun maps arrive as typed
-- `render_target` values on the root entry.  Coarse occlusion history and GTAO
-- working values are ordinary arrays; the compiler owns their physical storage
-- and schedules the graphics/compute dependencies implied by value flow.

------------------------------------------------------------
-- Cull (Nine's simple path). A lightweight predicate filters original candidate
-- indices — cobble setts first, then wall bricks/quoins/grout. Only surviving indices
-- are resolved into complete `prop` records, so rejected candidates pay no basis,
-- roundness, colour, or draw cost. Output 0 = prop_inst, output 1 = prop_args.
------------------------------------------------------------

-- The prop domain: the running-bond sett grid, then the wall-brick slots.
def PROP_SETTS: i32 = BCOLS * BROWS
def PROP_WALLS: i32 = BRICK_SLOTS + QUOIN_SLOTS + GROUT_SLOTS
def PROP_SLOTS: i32 = PROP_SETTS + PROP_WALLS

-- Wall visibility tests each live block against the camera frustum.
def wall_visible(frame: frame_globals, wall_brick_index: i32) bool =
  let brick = wall_brick(wall_brick_index) in
  if brick.center.y <= 0.0 then false
  else frustum_keep(brick.center, magnitude(brick.half), frame.resolution, camera_from_frame(frame))

-- One surviving wall block. Blocks carry their own half-extents and a yaw; a tiny
-- corner radius keeps the edges crisp. `kind` (0 brick, 1 quoin, 2 grout) selects
-- colour here and is not carried into the draw stream.
def wall_prop(wall_brick_index: i32) prop =
  let brick = wall_brick(wall_brick_index)
  let center = brick.center
  let (right, up, forward) = gfx.transform.yaw_basis(brick.yaw)
  let kind = f32(brick.kind)
  -- Tone seeds from the stable, baked centre — bricks mix two fired-clay tones by a
  -- position hash; quoins are pale limestone with only a faint lightness wobble.
  let brightness = brick_hash(i32(center.x * 53.0 + center.z * 131.0 + center.y * 311.0 + 10000.0))
  let hue = brick_hash(i32(center.x * 97.0 + center.z * 57.0 + center.y * 181.0 + 10000.0))
  let albedo = if kind > 1.5 then GROUT_COLOR
               else if kind > 0.5 then QUOIN_COLOR * v3(0.90 + 0.16 * brightness)
               else mix(BRICK_BASE, BRICK_BASE2, hue) * v3(0.80 + 0.40 * brightness)
  in
  { center = center, radius = 0.004, half = brick.half,
    right = right, up = up, fwd = forward, albedo = albedo }

-- Filter original candidate indices before constructing their full prop records.
def prop_index_visible(frame: frame_globals, painted_scene: painted,
                       occlusion_depth: []f32, candidate_index: i32) bool =
  if candidate_index < PROP_SETTS then
    sett_visible(frame.resolution, camera_from_frame(frame), painted_scene.items, painted_scene.points,
                 occlusion_depth, candidate_index)
  else wall_visible(frame, candidate_index - PROP_SETTS)

def prop_from_index(candidate_index: i32) prop =
  if candidate_index < PROP_SETTS then sett_prop(candidate_index)
  else wall_prop(candidate_index - PROP_SETTS)

def prop_draw(instance_count: i32) draw_command =
  { vertex_count = 36u32, instance_count = u32(instance_count),
    first_vertex = 0u32, first_instance = 0u32 }

def cull_props(painted_scene: painted, frame: frame_globals,
               occlusion_depth: []f32) visibility =
  let live_indices =
    filter(|i| prop_index_visible(frame, painted_scene, occlusion_depth, i), iota(PROP_SLOTS))
  let visible_props = map(prop_from_index, live_indices) in
  { prop_inst = visible_props, draw = prop_draw(length(live_indices)) }

-- Minimum depth per coarse tile, saved for next frame's visibility tests.
-- Clamp reads at partial edge tiles so out-of-bounds depth cannot fake an occluder.
def occ_reduce_tile(scene: render_target<gbuffer>, resolution: vec3f32,
                    tile: vec2i32) f32 =
  let max_x = i32(resolution.x) - 1
  let max_y = i32(resolution.y) - 1 in
  loop nearest_depth = 1.0 for k < 64 do
    let sx = clampi(tile.x * OCC_TILE + (k % OCC_TILE), 0, max_x)
    let sy = clampi(tile.y * OCC_TILE + (k / OCC_TILE), 0, max_y)
    let sample_depth = target_load(scene, @[sx, sy], 0u32).depth in
    f32.min(nearest_depth, sample_depth)

------------------------------------------------------------
-- Deferred G-buffer. The scene fragments
-- write a thin G-buffer (albedo, world normal,
-- window depth) as MRT targets, and a fullscreen `resolve_fragment` reads it back
-- and does the lighting + tonemap once, over the whole image. This unifies shading
-- and is where AO / contact shadows belong. g_albedo.w is a valid mask (0 = sky).
------------------------------------------------------------

-- Project tessellated ground vertices and write their surface data to the G-buffer.
type scene_varying = { kind: f32, attr: f32, normal: vec3f32 }

-- Pull (pos.xyz, kind) and (nrm.xyz, attr) for one requested vertex and project.
-- The complete varying payload is an ordinary record in the unified vocabulary.
def scene_vertex(frame: frame_globals, vertex_positions: []vec4f32,
                 vertex_normals: []vec4f32, vertex_index: u32,
                 _instance_index: u32, _draw_index: u32)
  vertex<scene_varying> =
  let index = i32(vertex_index)
  let vertex = ground_vertex_from_packed(vertex_positions[index], vertex_normals[index]) in
  vertex_output(
    world_to_clip(vertex.pos, frame.resolution, camera_from_frame(frame)),
    { kind = vertex.kind, attr = vertex.attr, normal = vertex.nrm })

def item_color(kind: f32) vec3f32 =
  if kind < 0.5 then SAND_COLOR
  else if kind < 1.5 then WATER_COLOR
  else if kind < 2.5 then WALL_COLOR
  else BUILDING_COLOR

-- Shade one ground fragment: material color from `kind`, a darker edging course
-- near a stroke boundary (|attr| -> 1), lit by the (up) normal, then tonemapped.
-- G-buffer write for the ground: albedo (material color + stroke edging, pre-light)
-- @0, world normal @1, window depth @2 (also feeds the Hi-Z pyramid). No lighting.
def scene_fragment(value: scene_varying, position: vec4f32,
                   _front_facing: bool, _primitive_index: u32, _sample_index: u32) gbuffer =
  let normal = normalize(value.normal)
  let base = item_color(value.kind)
  let edge = smoothstep(0.78, 1.0, f32.abs(value.attr))
  let surface_color = mix(base, OUTLINE_COLOR, edge * 0.5) in
  { albedo = @[surface_color..., 1.0],
    normal = @[normal..., 1.0],
    depth = position.z }

------------------------------------------------------------
-- Props: instanced proxy boxes (Tiny-Glade "tons of tiny instances"). Cobble setts
-- and wall bricks/quoins/grout are one stream of `prop` records, so ONE vertex +
-- fragment pair draws them all. `cull_props` first compacts visible candidate indices,
-- then resolves placement, orientation, roundness, and colour only for survivors.
-- The vertex places the proxy box; the fragment
-- sphere-traces the rounded box inside it, so the silhouette rounds per instance.
-- The proxy's outer extent IS the rounded box's, so the trace starts on its front
-- face. The wall blocks are real occluders for the cobbles.
------------------------------------------------------------

-- Box-local proxy corner -> world, using the instance's own basis and half-extents.
-- `box_pos` has y in [0,1]; centring it (y - 0.5) makes the box tilt about its middle.
def prop_world(prop_instance: prop, local_position: vec3f32) vec3f32 =
  let centered_position = @[local_position.x * (prop_instance.half.x * 2.0),
             (local_position.y - 0.5) * (prop_instance.half.y * 2.0),
             local_position.z * (prop_instance.half.z * 2.0)] in
  prop_instance.center + gfx.transform.orient(centered_position, prop_instance.right, prop_instance.up, prop_instance.fwd)

type prop_varying = { world: vec3f32, instance: u32 }

def prop_vertex(frame: frame_globals, prop_instances: []prop,
                vertex_index: u32, instance_index: u32,
                _draw_index: u32) vertex<prop_varying> =
  let instance = prop_instances[i32(instance_index)]
  let world = prop_world(instance, box_pos[i32(vertex_index)]) in
  -- `instance_index` rides through as a varying: it is constant across the primitive, so any
  -- interpolation returns it unchanged, and the fragment re-reads the instance
  -- instead of carrying its whole record through the rasterizer. The compacted
  -- stream contains no center.y <= 0 tombstones.
  vertex_output(
    world_to_clip(world, frame.resolution, camera_from_frame(frame)),
    { world = world, instance = instance_index })

-- Sphere-trace this instance's rounded box from the proxy's front face. On a hit,
-- shade from the SDF normal and write the hit's true depth; on a miss (the ray
-- grazes a rounded-off corner) discard the fragment to carve the silhouette.
def prop_fragment(frame: frame_globals, prop_instances: []prop,
                  value: prop_varying) fragment_output<gbuffer> =
  let ray_start = value.world
  let instance = prop_instances[i32(value.instance)]
  let radius = instance.radius
  -- Trace in box-local space: project the world offset onto the instance's basis.
  let ray_direction = normalize(ray_start - cam_eye(camera_from_frame(frame)))
  let (t, hit) =
    loop (t, hit) = (0.0, false) for _i < 24 do
      if hit then (t, hit)
      else
        let center_offset = (ray_start + ray_direction * t) - instance.center
        let local_position = gfx.transform.unorient(center_offset, instance.right, instance.up, instance.fwd)
        let surface_distance = sd_round_box(local_position, instance.half, radius) in
        if surface_distance < 0.0004 then (t, true) else (t + surface_distance, false)
  let hit_position = ray_start + ray_direction * t in
  if hit then
    let center_offset = hit_position - instance.center
    let local_position = gfx.transform.unorient(center_offset, instance.right, instance.up, instance.fwd)
    let local_normal = round_normal(local_position, instance.half, radius)
    let world_normal = gfx.transform.orient(local_normal, instance.right, instance.up, instance.fwd)
    let clip = world_to_clip(hit_position, frame.resolution, camera_from_frame(frame))
    let hit_depth = clip.z / clip.w in
    -- G-buffer: albedo @0 (valid mask a=1), world normal @1, depth @2 + frag_depth.
    #depth(
      { albedo = @[instance.albedo..., 1.0],
        normal = @[world_normal..., 1.0],
        depth = hit_depth },
      hit_depth)
  else
    #discard

------------------------------------------------------------
-- Sun shadow map — caster pass. The wall-brick proxy boxes projected through the
-- sun's orthographic light camera (world_to_light) into the sun_depth map. The
-- fragment writes its light-space depth (frag_coord.z); the depth test keeps the
-- nearest caster per texel. `resolve_fragment` reads this back to cast long
-- directional shadows.
--
-- Regenerate wall instances from their indices so shadow casters are independent
-- of camera visibility. Dead wall slots collapse to a degenerate vertex.
------------------------------------------------------------

def brick_shadow_vertex(vertex_index: u32, instance_index: u32,
                        _draw_index: u32) vertex<()> =
  let brick = wall_brick(i32(instance_index)) in
  let position =
    if brick.center.y <= 0.0 then @[2.0, 2.0, 2.0, 1.0]
  else
    let center = brick.center
    let cos_yaw = f32.cos(brick.yaw)
    let sin_yaw = f32.sin(brick.yaw)
    let half_extents = brick.half
    let local = box_pos[i32(vertex_index)]
    let lx = local.x * (half_extents.x * 2.0)
    let ly = (local.y - 0.5) * (half_extents.y * 2.0)
    let lz = local.z * (half_extents.z * 2.0)
    let world = @[center.x + cos_yaw * lx - sin_yaw * lz, center.y + ly, center.z + sin_yaw * lx + cos_yaw * lz] in
    world_to_light(world) in
  vertex_output(position, ())

-- Depth-only caster shade: store this fragment's light-space depth in the scalar
-- sun target; the target's depth attachment keeps the nearest caster.
def shadow_fragment(_value: (), position: vec4f32,
                    _front_facing: bool, _primitive_index: u32, _sample_index: u32) f32 =
  position.z

-- Perspective constants for GTAO, built from the live viewport + camera FOV (vertical
-- 20°) and clip planes. Frame 0: no temporal accumulation (we have no TAA), so the
-- per-pixel noise is static and the denoise pass cleans it up spatially.
def gtao_consts(resolution: vec3f32) gtao.consts =
  gtao.make_constants(resolution.xy, f32.tan(f32.radians(10.0)),
                      CLIP_NEAR, CLIP_FAR, 0u32, gtao.default_settings)

-- Linearize scene_depth (NDC) to viewspace depth. Sky (far plane) is pinned
-- to CLIP_FAR so it stays finite and never reads as an occluder.
def gtao_scene_vdepth(scene: render_target<gbuffer>, constants: gtao.consts,
                     pixel: vec2i32) f32 =
  let ndc = target_load(scene, pixel, 0u32).depth in
  if ndc > 0.99999 then CLIP_FAR
  else gtao.clamp_depth(gtao.screen_to_viewspace_depth(ndc, constants))

def gtao_load_scene_vdepth(scene: render_target<gbuffer>, constants: gtao.consts,
                          pixel_x: i32, pixel_y: i32) f32 =
  let cx = clampi(pixel_x, 0i32, i32(constants.viewport_size.x) - 1i32)
  let cy = clampi(pixel_y, 0i32, i32(constants.viewport_size.y) - 1i32) in
  gtao_scene_vdepth(scene, constants, @[cx, cy])

def gtao_load_scene_vdepth_uv(scene: render_target<gbuffer>, constants: gtao.consts,
                             texture_coordinates: vec2f32) f32 =
  gtao_load_scene_vdepth(scene, constants,
                         i32(f32.floor(texture_coordinates.x * constants.viewport_size.x)),
                         i32(f32.floor(texture_coordinates.y * constants.viewport_size.y)))

-- GTAO main (High preset = 3 slices x 3 steps), normals reconstructed from
-- linearized scene depth. Writes raw visibility (.x) + packed denoise edges (.y).
def gtao_main_pixel(scene: render_target<gbuffer>, constants: gtao.consts,
                    pixel: vec2i32) vec4f32 =
  let cz = gtao_load_scene_vdepth(scene, constants, pixel.x, pixel.y)
  let lz = gtao_load_scene_vdepth(scene, constants, pixel.x - 1i32, pixel.y)
  let rz = gtao_load_scene_vdepth(scene, constants, pixel.x + 1i32, pixel.y)
  let tz = gtao_load_scene_vdepth(scene, constants, pixel.x, pixel.y - 1i32)
  let bz = gtao_load_scene_vdepth(scene, constants, pixel.x, pixel.y + 1i32)
  let nrm = gtao.viewspace_normal_from_depths(pixel, cz, lz, rz, tz, bz, constants)
  let packed_edges = gtao.pack_edges(gtao.calculate_edges(cz, lz, rz, tz, bz))
  let pixel_setup = gtao.setup_pixel(pixel, cz, constants)
  let noise = gtao.spatiotemporal_noise(@[u32(pixel.x), u32(pixel.y)], 0u32)
  let visibility =
    loop vis = pixel_setup.visibility_base for slice < 3 do
      let slice_setup = gtao.setup_slice(pixel_setup, slice, 3, noise.x, nrm) in
      let (hc0, hc1) =
        loop (hc0, hc1) = (slice_setup.low_horizon_cos0, slice_setup.low_horizon_cos1)
        for step < 3 do
          let (sample_offset, _) = gtao.step_sample(pixel_setup, slice_setup, slice, step, 3, noise.y, constants)
          let uv0 = pixel_setup.nsp + sample_offset
          let uv1 = pixel_setup.nsp - sample_offset
          let sample_depth0 = gtao_load_scene_vdepth_uv(scene, constants, uv0)
          let sample_depth1 = gtao_load_scene_vdepth_uv(scene, constants, uv1) in
          gtao.horizon_fold(pixel_setup, slice_setup, uv0, sample_depth0, uv1, sample_depth1, hc0, hc1, constants)
      in
      vis + gtao.slice_visibility(slice_setup, hc0, hc1)
  let vis = gtao.finalize_visibility(visibility, 3, constants) in
  @[vis, packed_edges, 0.0, 1.0]

-- Post-scene work is ordinary array computation. The compiler chooses and orders
-- the physical compute stages because both maps read the scene render target and
-- their values feed later work (or the next frame).
def build_postprocess(scene: render_target<gbuffer>, resolution: vec3f32)
  ([]vec4f32, []f32) =
  let width = i32(resolution.x)
  let height = i32(resolution.y)
  let constants = gtao_consts(resolution)
  let ao_work =
    map(|i| gtao_main_pixel(scene, constants, @[i % width, i / width]), iota(width * height))
  let tile_columns = occ_w(resolution)
  let tile_rows = occ_h(resolution)
  let next_occlusion =
    map(|i| occ_reduce_tile(scene, resolution, @[i % tile_columns, i / tile_columns]),
        iota(tile_columns * tile_rows)) in
  (ao_work, next_occlusion)

def load_ao_edges(occlusion_samples: []vec4f32, pixel_x: i32, pixel_y: i32,
                  constants: gtao.consts) vec2f32 =
  let w = i32(constants.viewport_size.x)
  let cx = clampi(pixel_x, 0i32, w - 1i32)
  let cy = clampi(pixel_y, 0i32, i32(constants.viewport_size.y) - 1i32) in
  occlusion_samples[cy * w + cx].xy

def denoise_ao(pixel: vec2i32, occlusion_samples: []vec4f32, constants: gtao.consts)
  (f32, f32) =
  let center = load_ao_edges(occlusion_samples, pixel.x, pixel.y, constants)
  let l  = load_ao_edges(occlusion_samples, pixel.x - 1i32, pixel.y, constants)
  let r  = load_ao_edges(occlusion_samples, pixel.x + 1i32, pixel.y, constants)
  let t  = load_ao_edges(occlusion_samples, pixel.x, pixel.y - 1i32, constants)
  let b  = load_ao_edges(occlusion_samples, pixel.x, pixel.y + 1i32, constants)
  let tl = load_ao_edges(occlusion_samples, pixel.x - 1i32, pixel.y - 1i32, constants)
  let tr = load_ao_edges(occlusion_samples, pixel.x + 1i32, pixel.y - 1i32, constants)
  let bl = load_ao_edges(occlusion_samples, pixel.x - 1i32, pixel.y + 1i32, constants)
  let br = load_ao_edges(occlusion_samples, pixel.x + 1i32, pixel.y + 1i32, constants) in
  gtao.denoise_kernel(center, l, r, t, b, tl, tr, bl, br, constants, true)

-- The GTAO edge-aware denoise (final blur of occlusion_samples) is NOT a separate pass — it
-- reads only gtao_main's output, so `shade_frame` folds it in inline (see its `ao`).
------------------------------------------------------------
-- Deferred lighting combines surface colour and normal with ambient occlusion,
-- contact shadows, and the sun shadow map, then applies tonemapping.
------------------------------------------------------------

-- Sky shade for a G-buffer miss, sampled along the pixel's view ray.
-- pixel_center uses bottom-up coordinates.
def shade_sky(resolution: vec3f32, pixel_center: vec2f32, camera: orbit) vec4f32 =
  let (_, ray_direction) = get_ray(resolution, pixel_center, camera)
  let sky_color = clouds.sky(ray_direction) in
  @[sky_color..., 1.0]

-- Deferred shade for one pixel: read the thin G-buffer at (x,y) and return its final
-- colour. Sky pixels get the cloud sky; lit pixels get GTAO (the edge-aware denoise
-- folded in — it only reads gtao_main's ao_work), the sun contact march + sun-shadow-
-- map PCF (shadow.wyn owns both marches, which take the depth images directly), and
-- the AO/shadow-attenuated shade. The image-touching helpers are ordinary defs — the
-- compiler specializes each to its resource global.
def shade_frame(scene: render_target<gbuffer>, sun_depth: render_target<f32>,
                occlusion_samples: []vec4f32, frame: frame_globals,
                painted_scene: painted, pixel_x: i32, pixel_y: i32) vec4f32 =
  let width = frame.resolution.x
  let height = frame.resolution.y
  let resolution = @[width, height, 0.0]
  let camera = camera_from_frame(frame)
  let ao_off = (frame.mods & 2u32) != 0u32              -- hold Ctrl to suppress AO
  let surface = target_load(scene, @[pixel_x, pixel_y], 0u32)
  let pixel_center = @[f32(pixel_x) + 0.5, height - (f32(pixel_y) + 0.5)] in    -- pixel centre, bottom-up
  if surface.albedo.w < 0.5 then shade_sky(resolution, pixel_center, camera)
  else
    let normal = normalize(surface.normal.xyz)
    let (_, ray_direction) = get_ray(resolution, pixel_center, camera)
    let surface_position = world_from_depth(resolution, pixel_center, camera, surface.depth)
    -- Water (approach A): only a ground-level pixel (world y ~ 0) can be canal. `canal_distance` is its
    -- signed distance to the water edge: < -QUAY_RIM traces the sunken water/quay per
    -- pixel; the [-QUAY_RIM, 0) lip is lit as a wet-stone quay cap; >= 0 is dry land.
    let canal_distance =
      if surface_position.y < 0.03 then
        water_sdf(surface_position.xz, painted_scene.items, painted_scene.points)
      else 1.0 in
    if canal_distance < 0.0 - QUAY_RIM then
      let water_color = shade_water(surface_position, ray_direction, frame.time, painted_scene.items, painted_scene.points) in
      @[water_color..., 1.0]
    else
      let base = if canal_distance < 0.0 then QUAY_COLOR else surface.albedo.xyz
      let ao = if ao_off then 0.0
               else let (visibility, _) = denoise_ao(@[pixel_x, pixel_y], occlusion_samples, gtao_consts(resolution)) in 1.0 - visibility
      let shadow_origin = surface_position + normal * SH_LIFT
      let contact_occlusion = contact_shadow(scene, shadow_origin, normal, resolution, camera)
      let sun_occlusion = sun_shadow_pcf(sun_depth, shadow_origin, width, height) in
      shade_surface(base, normal, ao, contact_occlusion, sun_occlusion)

------------------------------------------------------------
-- Deferred resolve. One fullscreen triangle covers every pixel and its fragment
-- lights that pixel straight to the surface, reading the thin G-buffer, the depth
-- images, and the painted buffers the canal SDF needs.
------------------------------------------------------------

-- Fullscreen triangle from the vertex index: (-1,-1), (3,-1), (-1,3) covers the
-- whole clip rect with one primitive (no vertex buffer).
def blit_vertex(vertex_index: u32, _instance_index: u32,
                _draw_index: u32) vertex<()> =
  let vid = i32(vertex_index)
  let x = if vid == 1 then 3.0 else 0.0 - 1.0
  let y = if vid == 2 then 3.0 else 0.0 - 1.0 in
  vertex_output(@[x, y, 0.0, 1.0], ())

def resolve_fragment(inputs: lighting_inputs, frame: frame_globals,
                     painted_scene: painted, _value: (), position: vec4f32,
                     _front_facing: bool, _primitive_index: u32, _sample_index: u32) vec4f32 =
  shade_frame(inputs.scene, inputs.sun_depth, inputs.ao_work,
              frame, painted_scene, i32(position.x), i32(position.y))

-- Shared opaque-depth state for the sun and scene draws. Physical attachments,
-- barriers, pipeline order, and indirect command dependencies are derived from
-- this root operation by the compiler.
def opaque_depth: fragment_state = {
  depth_test = #less_equal,
  depth_write = true,
  blend = #replace,
  color_write = true,
}

-- Render the previous world while producing the next one. Visibility also reads
-- the previous frame's coarse depth; this frame's depth becomes next frame's history.
-- The flat input/output tuple is the host ABI; the algorithm uses named records.
entry tinyporto_frame(
    uistate_in: []f32,
    points_in: []vec2f32,
    items_in: []vec4f32,
    head_in: []f32,
    occ_in: []f32,
    events: []vec4f32,
    frame: frame_globals,
    sun: render_target<f32>,
    scene: render_target<gbuffer>,
    surface: render_target<vec4f32>)
    ([]f32, []vec2f32, []vec4f32, []f32, []f32,
     render_target<f32>, render_target<gbuffer>, render_target<vec4f32>) =
  let next_world = update_world(frame, events, { ui = uistate_in, points = points_in, items = items_in, head = head_in })
  let ground = tessellate_ground({ ui = uistate_in, points = points_in, items = items_in, head = head_in })
  let visible = cull_props({ points = points_in, items = items_in }, frame, occ_in)

  -- Render sunlight visibility from all walls, independently of the camera.
  let shadow_fragments = rasterize_triangles(
    direct_draw(36u32, u32(PROP_WALLS)), brick_shadow_vertex)
  let sun_depth = shade_with(opaque_depth, sun, shadow_fragments, shadow_fragment)

  -- Fill the scene G-buffer with the ground, then the visible props.
  let ground_fragments = rasterize_triangles(
    indirect_draw(ground.draw),
    scene_vertex(frame, ground.geom_pos, ground.geom_nrm, _, _, _))
  let ground_image = shade_with(opaque_depth, scene, ground_fragments, scene_fragment)
  let prop_fragments = rasterize_triangles(
    indirect_draw(visible.draw), prop_vertex(frame, visible.prop_inst, _, _, _))
  let scene_image = shade_with(
    opaque_depth, ground_image, prop_fragments,
    |value, _, _, _, _| prop_fragment(frame, visible.prop_inst, value))

  -- Estimate ambient occlusion and save coarse depth for the next frame.
  let (ambient_occlusion, next_occlusion) = build_postprocess(scene_image, frame.resolution)

  -- Light every pixel of the finished image.
  let pixels = rasterize_triangles(direct_draw(3u32, 1u32), blit_vertex)
  let image = shade(surface, pixels,
    resolve_fragment({ scene = scene_image, sun_depth = sun_depth, ao_work = ambient_occlusion },
                     frame, { points = points_in, items = items_in }, _, _, _, _, _)) in

  (next_world.ui, next_world.points, next_world.items, next_world.head,
   next_occlusion, sun_depth, scene_image, image)
