-- shade: palette, sun lighting, and tonemapping.
-- Library module: no `open` (see math.wyn for the idiom); f32.* qualified.

import "math"   -- bare import: brings clamp01 etc. into scope unqualified

def SUN_DIR: vec3f32 = @[0.0 - 0.5, 0.52, 0.35]
def SUN_COLOR: vec3f32 = @[2.0, 1.95, 1.85]
def AMBIENT: vec3f32 = @[0.22, 0.26, 0.32]

def SAND_COLOR: vec3f32 = @[0.24, 0.16, 0.10]
-- 1950s Venetian render / ochre plaster for the flat-roofed buildings.
def BUILDING_COLOR: vec3f32 = @[0.78, 0.42, 0.30]
-- Wall / fence painted ground: sage hedge green beside building-terracotta.
def WALL_COLOR: vec3f32 = @[0.34, 0.48, 0.30]
-- Subtle darker outline drawn at an item's boundary (the edging course).
def OUTLINE_COLOR: vec3f32 = @[0.12, 0.11, 0.10]

def sun: vec3f32 = normalize(SUN_DIR)

-- Ambient occlusion attenuates sky fill; directional shadow attenuates sunlight.
-- Keep a little sunlight even in full shadow to approximate bounced light.
def lit_ao_sh(albedo: vec3f32, n: vec3f32, ao: f32, sh: f32) vec3f32 =
  let ndl = clamp01(dot(n, sun))
  let occ = 1.0 - 0.75 * clamp01(ao)
  let sunvis = 1.0 - 0.85 * clamp01(sh) in
  albedo * (AMBIENT * v3(occ) + SUN_COLOR * v3(ndl * sunvis))

def tonemap_aces(x: vec3f32) vec3f32 =
  let a = 2.51
  let b = 0.03
  let c = 2.43
  let d = 0.59
  let e = 0.14 in
  (x * (a * x + v3(b))) / (x * (c * x + v3(d)) + v3(e))

-- Final shade for a lit G-buffer pixel: sky-ambient (AO-attenuated) + direct sun
-- (shadow-attenuated), tonemapped to an opaque colour. `ao` is the occlusion amount
-- (1 = fully occluded); `shc`/`shm_frac` are the contact-march and sun-shadow-map
-- occlusion, combined by `max` (either one blocks the sun).
-- Dielectric GGX sunlight, with Schlick Fresnel and Smith masking. GI remains
-- diffuse: do not feed this view-dependent highlight back into its radiance.
def sun_specular(n: vec3f32, view: vec3f32, roughness: f32) vec3f32 =
  let nl = clamp01(dot(n, sun))
  let nv = f32.max(0.001, clamp01(dot(n, view)))
  let h = normalize(sun + view)
  let nh = clamp01(dot(n, h))
  let vh = clamp01(dot(view, h))
  let a = f32.max(0.04, roughness * roughness)
  let a2 = a * a
  let denom = nh * nh * (a2 - 1.0) + 1.0
  let distribution = a2 / (f32.pi * denom * denom)
  let visibility = 0.5 / f32.max(0.001,
    nl * f32.sqrt(nv * nv * (1.0 - a2) + a2)
      + nv * f32.sqrt(nl * nl * (1.0 - a2) + a2))
  let fresnel = 0.04 + 0.96 * f32.pow(1.0 - vh, 5.0) in
  SUN_COLOR * (distribution * visibility * fresnel * nl)

def shade_surface(albedo: vec3f32, n: vec3f32, ao: f32, shc: f32, shm_frac: f32,
                   specular: vec3f32) vec4f32 =
  let sh = f32.max(shc, shm_frac)
  let col = lit_ao_sh(albedo, n, ao, sh) + specular * (1.0 - clamp01(sh))
  let m = tonemap_aces(col) in
  @[m.x, m.y, m.z, 1.0]

-- GI supplies the indirect illumination: no constant ambient or artificial sun
-- floor in this path. GTAO adds only the fine detail absent from the trace proxies.
def shade_surface_gi(albedo: vec3f32, n: vec3f32, ao: f32, shadow: f32,
                      indirect: vec3f32, indirect_only: bool, specular: vec3f32) vec4f32 =
  let direct = if indirect_only then v3(0.0)
               else SUN_COLOR * (clamp01(dot(n, sun)) * (1.0 - clamp01(shadow)))
  let light = albedo * (direct + indirect * (1.0 - 0.2 * clamp01(ao)))
                + (if indirect_only then v3(0.0) else specular * (1.0 - clamp01(shadow)))
  let mapped = tonemap_aces(light) in
  @[mapped.x, mapped.y, mapped.z, 1.0]
