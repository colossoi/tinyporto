-- bricks: cobblestone setts laid in a running-bond grid over cobble ground.
-- Library module (no `open`; f32.* / vec.* qualified).
--
-- Each sett is an instanced proxy box. The fragment shader sphere-traces its
-- rounded-box surface to compute the silhouette, normal, and depth.

import "pkg:rng"
import "math"
import "camera"
import "paint"
import "hiz"

-- Sett palette. Cobble is a mid-tone neutral ranging from warm earthy greige to
-- architectural grey with a soft blue undertone. Each sett draws an independent hash
-- for hue (mix of these two), saturation (grey <-> full undertone), and lightness, so
-- the field reads varied rather than washed out and uniform (see sett_prop).
def COBBLE_WARM: vec3f32 = @[0.55, 0.46, 0.36]   -- warm earthy greige
def COBBLE_COOL: vec3f32 = @[0.38, 0.43, 0.52]   -- architectural grey, soft blue undertone

-- Sett dimensions (meters), from a 10"x7"x4" cobble reference.
def BRICK_W: f32 = 0.24     -- x footprint: the LONG axis, along the row
def BRICK_L: f32 = 0.15     -- z footprint: the short axis / width (setts read ~1.6:1)
def BRICK_H: f32 = 0.05     -- protrusion above ground (chunky stone, so the rounding reads)

def CELLX: f32 = 0.255      -- along-row cell pitch (long axis + a tight joint)
def CELLZ: f32 = 0.175      -- cross-row pitch (short axis + a tight joint)

-- Running-bond grid covering the ~40 m ground (centered on origin).
-- BCOLS * BROWS determines the sett candidate count.
def BCOLS: i32 = 168
def BROWS: i32 = 220

-- World-space (x,z) center of sett i. Odd rows shift half a cell (running bond).
def brick_center(i: i32) vec2f32 =
  let col = i % BCOLS in
  let row = i / BCOLS in
  let offx = if row % 2 == 1 then CELLX * 0.5 else 0.0 in
  let x = (f32(col) - f32(BCOLS) * 0.5 + 0.5) * CELLX + offx in
  let z = (f32(row) - f32(BROWS) * 0.5 + 0.5) * CELLZ in
  @[x, z]

-- Smooth local-space normal of a rounded box at a surface point. `half` is the
-- outer half-size and `radius` must not exceed its smallest component.
def round_normal(p: vec3f32, half: vec3f32, radius: f32) vec3f32 =
  let qx = f32.max(f32.abs(p.x) - (half.x - radius), 0.0)
  let qy = f32.max(f32.abs(p.y) - (half.y - radius), 0.0)
  let qz = f32.max(f32.abs(p.z) - (half.z - radius), 0.0) in
  normalize(@[f32.sign(p.x) * qx + 1e-6 * p.x,
              f32.sign(p.y) * qy,
              f32.sign(p.z) * qz])

-- Exterior rounded-box distance for sphere tracing. The full signed-distance
-- interior term is intentionally omitted because tracing starts outside.
def sd_round_box(p: vec3f32, half: vec3f32, radius: f32) f32 =
  let qx = f32.max(f32.abs(p.x) - (half.x - radius), 0.0)
  let qy = f32.max(f32.abs(p.y) - (half.y - radius), 0.0)
  let qz = f32.max(f32.abs(p.z) - (half.z - radius), 0.0) in
  magnitude(@[qx, qy, qz]) - radius

-- Per-sett deterministic value in [0,1) for color variation.
def brick_hash(i: i32) f32 =
  fasthash.at_f32(fasthash.seed(0xA341316Cu32), u32.i32(i))

-- Stable per-sett seed from its world (x,z) centre. Keyed on position, NOT the
-- compacted instance index (which reorders as culling changes each frame), so a
-- sett's size / yaw / tone stay put. Cobbles are irregular — unlike wall bricks
-- they vary in footprint and orientation.
def sett_seed(cx: f32, cz: f32) i32 = i32(cx * 53.0 + cz * 131.0 + 20000.0)
def sett_scale(cx: f32, cz: f32) f32 = 0.93 + 0.18 * brick_hash(sett_seed(cx, cz) + 7)
def sett_yaw(cx: f32, cz: f32) f32 = (brick_hash(sett_seed(cx, cz) + 31) - 0.5) * 0.15
def sett_var(cx: f32, cz: f32) f32 = brick_hash(sett_seed(cx, cz) + 3)

-- Along-row (local x) half-extent, clamped so a sett never crosses its cell's x-lane.
-- Cull places setts on the exact cell x (no along-row jitter), so this clamp makes it
-- impossible for two setts to overlap ALONG their length, whatever their scale/yaw.
-- SETT_JOINT is the min half-gap kept at the lane edge (covers the small yaw skew).
-- The cross (z) half stays BRICK_L*0.5*sc, so setts still vary in width and size.
def SETT_JOINT: f32 = 0.008
def sett_hx(sc: f32) f32 = f32.min(BRICK_W * 0.5 * sc, CELLX * 0.5 - SETT_JOINT)

-- Per-sett orientation as an orthonormal basis (right, up, fwd). `up` is a slightly
-- random top normal, so the stone leans in SOME direction (a normal captures tilt
-- in any direction, unlike a single-axis pitch). `yaw` is the separate spin about
-- that normal, orienting the rectangular footprint. Vertex (place the proxy) and
-- fragment (trace) both build this from the stable centre so they agree.
def sett_basis(cx: f32, cz: f32) (vec3f32, vec3f32, vec3f32) =
  let s = sett_seed(cx, cz)
  let tx = (brick_hash(s + 51) - 0.5) * 0.18
  let tz = (brick_hash(s + 61) - 0.5) * 0.18
  let yaw = sett_yaw(cx, cz)
  let up = normalize(@[tx, 1.0, tz])
  let fwd0 = @[f32.sin(yaw), 0.0, f32.cos(yaw)]
  let right = normalize(cross(up, fwd0))
  let fwd = cross(right, up) in
  (right, up, fwd)

-- Unit proxy box: x,z in [-0.5,0.5], y in [0,1]. Six faces, two triangles
-- per face, CCW from outside; the draw path scales and orients it per prop.
def box_pos: [36]vec3f32 =
  [-- +Y
   @[0.0 - 0.5, 1.0, 0.0 - 0.5], @[0.0 - 0.5, 1.0, 0.5], @[0.5, 1.0, 0.5],
   @[0.0 - 0.5, 1.0, 0.0 - 0.5], @[0.5, 1.0, 0.5], @[0.5, 1.0, 0.0 - 0.5],
   -- -Y
   @[0.0 - 0.5, 0.0, 0.0 - 0.5], @[0.5, 0.0, 0.0 - 0.5], @[0.5, 0.0, 0.5],
   @[0.0 - 0.5, 0.0, 0.0 - 0.5], @[0.5, 0.0, 0.5], @[0.0 - 0.5, 0.0, 0.5],
   -- +X
   @[0.5, 0.0, 0.0 - 0.5], @[0.5, 1.0, 0.0 - 0.5], @[0.5, 1.0, 0.5],
   @[0.5, 0.0, 0.0 - 0.5], @[0.5, 1.0, 0.5], @[0.5, 0.0, 0.5],
   -- -X
   @[0.0 - 0.5, 0.0, 0.0 - 0.5], @[0.0 - 0.5, 0.0, 0.5], @[0.0 - 0.5, 1.0, 0.5],
   @[0.0 - 0.5, 0.0, 0.0 - 0.5], @[0.0 - 0.5, 1.0, 0.5], @[0.0 - 0.5, 1.0, 0.0 - 0.5],
   -- +Z
   @[0.0 - 0.5, 0.0, 0.5], @[0.5, 0.0, 0.5], @[0.5, 1.0, 0.5],
   @[0.0 - 0.5, 0.0, 0.5], @[0.5, 1.0, 0.5], @[0.0 - 0.5, 1.0, 0.5],
   -- -Z
   @[0.0 - 0.5, 0.0, 0.0 - 0.5], @[0.0 - 0.5, 1.0, 0.0 - 0.5], @[0.5, 1.0, 0.0 - 0.5],
   @[0.0 - 0.5, 0.0, 0.0 - 0.5], @[0.5, 1.0, 0.0 - 0.5], @[0.5, 0.0, 0.0 - 0.5]]

-- One rounded-box prop, shared by cobbles, wall bricks, quoins, and grout.
-- Culling constructs these records only for surviving candidates; both vertex
-- and fragment shaders use the stored placement, basis, and material.
type prop = {
  center: vec3f32,     -- box centre, world
  radius: f32,         -- corner radius (<= min half extent)
  half: vec3f32,       -- half extents, box-local
  right: vec3f32,      -- orthonormal basis: box-local x, y, z in world
  up: vec3f32,
  fwd: vec3f32,
  albedo: vec3f32,
}

-- Stable world centre shared by the visibility predicate and live-prop builder.
-- The compacted stream can reorder instance IDs, so all variation remains keyed on
-- this centre or the original candidate index.
def sett_center(i: i32) vec2f32 =
  let base = brick_center(i)
  -- No along-row (x) jitter: setts sit on the exact cell x so the clamped along-row
  -- half-extent (sett_hx) can guarantee they never overlap along their length. A
  -- small cross-row (z) jitter keeps the courses from reading as a rigid grid.
  let jz = (brick_hash(i + 53) - 0.5) * 0.016 in
  @[base.x, base.y + jz]

-- Visibility is intentionally a cheapest-first control-flow ladder. In particular,
-- the water SDF scans the painted stroke data only after distance, frustum, and
-- coarse-occlusion rejection. The clip projection is shared by the latter two tests.
def sett_visible(resolution: vec3f32, camera: orbit,
                 items: []vec4f32, points: []vec2f32, od: []f32, i: i32) bool =
  let center = sett_center(i) in
  if dot(center, center) >= 64.0 then false
  else
    let c3 = @[center.x, BRICK_H * 0.5, center.y]
    let clip = world_to_clip(c3, resolution, camera) in
    -- 0.25 ≈ the sett proxy's bounding radius (footprint + tilt), generous.
    if !frustum_keep_clip(clip, 0.25, resolution) then false
    -- Hidden only if the nearest recorded surface wins across the whole tile
    -- neighbourhood, so a partly-visible sett stays.
    else if occ_test(od, clip, resolution) then false
    -- Water converts cobble to canal: reject setts near a painted canal edge.
    else water_sdf(center, items, points) >= 0.08

-- Build the complete record only after the candidate index survives compaction.
def sett_prop(i: i32) prop =
  let center = sett_center(i)
  let height = BRICK_H * (0.9625 + 0.075 * brick_hash(i))
  let ss = sett_scale(center.x, center.y)
  let (right, up, fwd) = sett_basis(center.x, center.y)
  let half = @[sett_hx(ss), height * 0.5, BRICK_L * 0.5 * ss]
  -- Roundness spread: some cobbles crisp, some well-rounded (wide variance).
  let roundfrac = 0.13 + 0.80 * brick_hash(i + 7919)
  let radius = roundfrac * f32.min(half.x, f32.min(half.y, half.z))
  -- Colour from three independent hashes: hue (warm greige <-> cool blue-grey),
  -- saturation (mute toward grey <-> enrich the undertone), and lightness. Skewed a
  -- touch dark (mean < 1) so the brightest setts don't blow out through the tonemap.
  let seed = sett_seed(center.x, center.y)
  let hued = mix(COBBLE_WARM, COBBLE_COOL, brick_hash(seed + 17))
  let g = (hued.x + hued.y + hued.z) * 0.3333
  let sat = 0.7 + 0.8 * brick_hash(seed + 29)
  let albedo = mix(v3(g), hued, sat) * v3(0.5 + 0.9 * sett_var(center.x, center.y)) in
  { center = @[center.x, height * 0.5, center.y], radius = radius, half = half,
    right = right, up = up, fwd = fwd, albedo = albedo }
