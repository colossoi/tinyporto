-- Hemisphere direction sampling shared by lighting integrators.
-- Wyn's built-in sampling namespace provides quasirandom sequences instead.
import "pkg:rng"

module hemisphere = {

  -- Deterministic pair in [0,1), independent of surface orientation.
  def uniform2(seed: u32) vec2f32 =
    let key = fasthash.seed(0x91E10DA5u32) in
    @[fasthash.at_f32(key, seed), fasthash.at_f32(key, seed + 1u32)]

  -- Map two uniform samples to a hemisphere about a unit normal.
  -- cosine=false: PDF=1/(2*pi); cosine=true: PDF=dot(n, direction)/pi.
  def direction(n: vec3f32, sample: vec2f32, cosine: bool) vec3f32 =
    let u = sample.x
    let v = sample.y
    let z = if cosine then f32.sqrt(1.0 - u) else u
    let r = f32.sqrt(f32.max(0.0, 1.0 - z * z))
    let phi = 6.2831853 * v
    let helper = if f32.abs(n.y) < 0.99 then @[0.0, 1.0, 0.0] else @[1.0, 0.0, 0.0]
    let tangent = normalize(cross(helper, n))
    let bitangent = cross(n, tangent) in
    tangent * (r * f32.cos(phi)) + bitangent * (r * f32.sin(phi)) + n * z
}
