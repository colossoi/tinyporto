-- math: shared scalar/vector helpers used across the tiny-porto shaders.
--
-- Library files are pulled in with bare imports. New APIs use explicit named
-- module blocks (ray.*, gi.*, etc.); older helpers still have flat exports.
-- Qualify scalar math as f32.* in libraries: repeated 'open f32' currently
-- causes ambiguous references. Only the root main.wyn opens f32.
-- Globals available WITHOUT any open: normalize, dot, cross, distance, reflect,
-- mix (scalar+vec), the `**` operator, and the `vec.*` module.

def clamp01(x: f32) f32 = f32.clamp(x, 0.0, 1.0)

def clampi(v: i32, lo: i32, hi: i32) i32 = if v < lo then lo else if v > hi then hi else v

-- Scalar -> vector broadcasts (Wyn arithmetic does not auto-broadcast).
def v2(s: f32) vec2f32 = @[s, s]
def v3(s: f32) vec3f32 = @[s, s, s]
