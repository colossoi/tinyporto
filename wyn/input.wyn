-- Input events drive UI changes and online stroke capture. Screen-to-ground
-- picking and event decoding live here; update_world consumes the results.
--
-- Library module: no `open`; f32.* qualified (see math.wyn for the idiom).

import "math"     -- distance / v3
import "camera"   -- get_ray / ground_t / orbit
import "pkg:curves"
import "paint"    -- STEP / CORRIDOR / MAXCHORD

-- Input event stream. The host appends one `vec4f32` per raw event since the last
-- frame and zero-pads the rest (kind 0 = None); the folds scan a fixed EV_CAP
-- window, skipping None slots. One event:
--   .x = kind*256 + mods   kind: 1 KeyDown 2 KeyUp 3 MouseDown 4 MouseUp 5 Move
--                          6 Wheel; mods = the modifier mask AT THE EVENT (frozen)
--   .y = code              keycode (KeyDown/Up) or button index (MouseDown/Up)
--   .z, .w = x, y          cursor position in pixels (wheel: dy in .z)
def EV_CAP:   i32 = 32   -- events folded per frame (host caps to this)
def EMIT_CAP: i32 = 16   -- control points a single frame may commit (array bound)
def EV_KEYDOWN:   i32 = 1
def EV_MOUSEDOWN: i32 = 3
def EV_MOUSEUP:   i32 = 4
def EV_MOUSEMOVE: i32 = 5
def BTN_LEFT: i32 = 0
def KEY_TAB:  i32 = 1    -- host-side keycode table (mirror of the driver's)
def KEY_L:    i32 = 2

type ui_state = { tool: f32, overlay: f32 }

def ui_state_from_buffer(xs: []f32) ui_state =
  { tool = xs[0], overlay = xs[1] }

def pack_ui_state(s: ui_state) [2]f32 =
  [s.tool, s.overlay]

type stroke_head = {
  point_count: i32,
  item_count: i32,
  held: f32,
  anchor: vec2f32,
  dir: vec2f32,
  last: vec2f32,
  have_dir: f32,
}

def stroke_head_from_buffer(xs: []f32) stroke_head =
  { point_count = i32(xs[0]), item_count = i32(xs[1]), held = xs[2],
    anchor = @[xs[3], xs[4]], dir = @[xs[5], xs[6]], last = @[xs[7], xs[8]],
    have_dir = xs[9] }

def pack_stroke_head(h: stroke_head) [12]f32 =
  [f32(h.point_count), f32(h.item_count), h.held, h.anchor.x, h.anchor.y,
   h.dir.x, h.dir.y, h.last.x, h.last.y, h.have_dir, 0.0, 0.0]

-- Screen pixel -> ground-plane point (same ray as the rendered cursor). `py` is
-- top-left pixel Y (as events carry it); flip to the bottom-left ray convention.
def screen_to_ground(resolution: vec3f32, o: orbit, px: f32, py: f32) vec2f32 =
  let mc = @[px, resolution.y - py]
  let (ro, rd) = get_ray(resolution, mc, o) in
  (ro + rd * v3(ground_t(ro, rd))).xz

-- Tab cycles the active tool; L toggles the overlay.
def apply_ui_shortcuts(previous_ui: ui_state, events: []vec4f32) ui_state =
  let (tool, overlay) =
    loop (tool, overlay) = (previous_ui.tool, previous_ui.overlay) for k < EV_CAP do
      let e = events[k]
      let kind = i32(e.x) / 256i32
      let code = i32(e.y) in
      if kind == EV_KEYDOWN && code == KEY_TAB then (f32((i32(tool) + 1) % 3), overlay)
      else if kind == EV_KEYDOWN && code == KEY_L then (tool, 1.0 - overlay)
      else (tool, overlay) in
  { tool = tool, overlay = overlay }

-- Stroke fold: thread the Reumann-Witkam strip (anchor/dir/last/have_dir) + held
-- through the frame's mouse events IN ORDER, committing control points into a
-- fixed emit array `em` at a running count `ec`. MouseDown starts a stroke and
-- plants its first point (a building plants only this one); MouseMove advances the
-- RW strip; MouseUp snaps a final point. Every emit is guarded by the EMIT_CAP
-- array bound (a very fast drag past the cap loses its tail — a soft limit).
type stroke_capture = {
  head: stroke_head,
  pressed: f32,
  emitted_count: i32,
  emitted: [16]vec2f32,
}

def capture_stroke_points(previous_head: stroke_head, events: []vec4f32,
                          resolution: vec3f32, camera: orbit, is_building: bool) stroke_capture =
  let z2 = @[0.0, 0.0]
  let (anchor, dir, last, hd, held, press, ec, em) =
    loop (anchor, dir, last, hd, held, press, ec, em) =
       (previous_head.anchor, previous_head.dir, previous_head.last,
        previous_head.have_dir, previous_head.held, 0.0, 0i32,
        [z2, z2, z2, z2, z2, z2, z2, z2, z2, z2, z2, z2, z2, z2, z2, z2])
    for k < EV_CAP do
      let e = events[k]
      let kind = i32(e.x) / 256i32
      let code = i32(e.y)
      let cur = screen_to_ground(resolution, camera, e.z, e.w) in
      if kind == EV_MOUSEDOWN && code == BTN_LEFT then
        -- Press: start the strip, plant the first point.
        if ec < EMIT_CAP then (cur, z2, cur, 0.0, 1.0, 1.0, ec + 1i32, em with [ec] = cur)
        else (cur, z2, cur, 0.0, 1.0, 1.0, ec, em)
      else if kind == EV_MOUSEMOVE && held > 0.5 && (!is_building) then
        if distance(cur, last) > STEP then
          let (emit, pos, na, nd, nl, nhd) =
            curves.reumann_witkam_advance(anchor, dir, last, hd > 0.5, cur, CORRIDOR, MAXCHORD)
          let hdf = if nhd then 1.0 else 0.0 in
          if emit && ec < EMIT_CAP then (na, nd, nl, hdf, held, press, ec + 1i32, em with [ec] = pos)
          else (na, nd, nl, hdf, held, press, ec, em)
        else (anchor, dir, last, hd, held, press, ec, em)
      else if kind == EV_MOUSEUP && code == BTN_LEFT then
        -- Release: snap a final point for a non-building stroke, then clear held.
        if held > 0.5 && (!is_building) && distance(last, anchor) > 0.05 && ec < EMIT_CAP then
          (anchor, dir, last, hd, 0.0, press, ec + 1i32, em with [ec] = last)
        else (anchor, dir, last, hd, 0.0, press, ec, em)
      else (anchor, dir, last, hd, held, press, ec, em) in
  { head = { point_count = previous_head.point_count, item_count = previous_head.item_count,
             anchor = anchor, dir = dir, last = last, have_dir = hd, held = held },
    pressed = press, emitted_count = ec, emitted = em }

-- Counts stop at the fixed buffer capacities, even if capture emits more points.
def record_capture_progress(previous_head: stroke_head, capture: stroke_capture) stroke_head =
  { point_count = if previous_head.point_count + capture.emitted_count < POINTS_CAP
                  then previous_head.point_count + capture.emitted_count else POINTS_CAP,
    item_count = if capture.pressed > 0.5 && previous_head.item_count < ITEMS_CAP
                 then previous_head.item_count + 1i32 else previous_head.item_count,
    held = capture.head.held, anchor = capture.head.anchor, dir = capture.head.dir,
    last = capture.head.last, have_dir = capture.head.have_dir }
