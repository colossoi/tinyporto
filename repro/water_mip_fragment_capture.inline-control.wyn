-- Control: inline sample() at both call sites in slopes().
type levels = { fine: []f32, coarse: []f32 }

def make_levels(values: []f32) levels =
  let fine = map(|x| x * 2.0, values)
  let coarse = map(|i| (fine[i * 2] + fine[i * 2 + 1]) * 0.5, (0..<8)) in
  { fine = fine, coarse = coarse }

def sample_level(f: levels, coarse: bool, i: i32) f32 =
  if coarse then f.coarse[i] else f.fine[i]

def sample(f: levels, p: vec2f32, scale: f32) f32 =
  sample_level(f, p.x > scale, i32(p.y) % 8)

def slopes(f: levels, p: vec2f32) f32 =
  let base = sample_level(f, p.x > 1.0, i32(p.y) % 8) in
  if p.y > 1.0 then base else base + sample_level(f, p.x > 2.0, i32(p.y) % 8)

entry reproduce(values: []f32, target: render_target<vec4f32>) render_target<vec4f32> =
  let f = make_levels(values)
  let pixels = rasterize_triangles(direct_draw(3u32, 1u32),
    |_, _, _| vertex_output(@[0.0, 0.0, 0.0, 1.0], ())) in
  shade(target, pixels, |_, position, _, _, _|
    let s = slopes(f, position.xy) in @[s, s, s, 1.0])
