-- Screen-space contact shadows and geometric directional shadows.

import "camera"   -- world_to_clip / world_from_depth / linear_depth
import "pkg:gfx"
import "render_types"

-- March tunables (world metres). Short range, so shadows ground bricks / cobbles /
-- wall bases in contact without leaking long streaks across the scene.
def SH_LIFT:  f32 = 0.02    -- lift the start point off its surface (anti-acne)
def SH_START: f32 = 0.05    -- first step distance toward the sun
def SH_STEP:  f32 = 0.06    -- per-step distance (20 steps ~= 1.2 m of reach)
def SH_BIAS:   f32 = 0.02   -- min depth gap (m) before a step counts as occluded
def SH_RADIUS: f32 = 0.12   -- the recorded occluder must sit within this of the sun-ray
                            -- sample in WORLD space; rejects a surface merely BESIDE the
                            -- ray that only shares the sample's screen pixel (the artifact)

-- The k-th sample point along the sun ray from an (already lifted) surface point.
def shadow_point(p: vec3f32, sundir: vec3f32, k: i32) vec3f32 =
  p + sundir * (SH_START + f32(k) * SH_STEP)

-- Project a clip-space sample to integer pixel coords. `valid` is false off-screen
-- or behind the eye (w <= 0). Returns (x, y, valid).
def shadow_pixel(cq: vec4f32, resolution: vec3f32) (i32, i32, bool) =
  if cq.w <= 0.0 then (0, 0, false)
  else
    let sx = i32((cq.x / cq.w * 0.5 + 0.5) * resolution.x)
    let sy = i32((1.0 - (cq.y / cq.w * 0.5 + 0.5)) * resolution.y)
    let inb = sx >= 0 && sx < i32(resolution.x) && sy >= 0 && sy < i32(resolution.y) in
    (sx, sy, inb)

-- Is the marched sun-ray sample `sp` (clip point `cq`) occluded? Two conditions:
-- the recorded surface at its pixel must sit IN FRONT of it (a screen-space visible
-- occluder), AND that surface's reconstructed world point `wp` must lie within
-- SH_RADIUS of the sample — so a real occluder ON the ray blocks the sun, while a
-- surface merely BESIDE the ray (same screen pixel, far-off world point) does not.
-- A far-plane surfd (~1, i.e. sky) never occludes.
def shadow_occluded(sp: vec3f32, wp: vec3f32, cq: vec4f32, surfd: f32) bool =
  let linq = linear_depth(cq.z / cq.w)
  let lins = linear_depth(surfd) in
  surfd < 0.99999 && linq > lins + SH_BIAS && magnitude(wp - sp) < SH_RADIUS

-- The full contact-shadow march for a surface point `p` (already surface-lifted) with
-- normal `n`, reading scene depth from `sd`. Marches toward the sun in world space,
-- re-projecting each step to screen and comparing against the recorded surface; a step
-- landing behind a nearer occluder ON the ray blocks the sun. Only marches where the
-- face sees the sun (a back-to-sun face is already unlit by ndl, so a shadow there is
-- a no-op that only adds noise). Returns occlusion in {0,1} (early-outs once blocked).
def contact_shadow(sd: render_target<gbuffer>, p: vec3f32, n: vec3f32,
                   resl: vec3f32, o: orbit, sun: vec3f32) f32 =
  let ry = resl.y
  let ndl = f32.max(dot(n, sun), 0.0) in
  if ndl <= 0.0 then 0.0
  else
    loop shc = 0.0 for k < 20 do
      if shc > 0.5 then shc
      else
        let sp = shadow_point(p, sun, k)
        let cq = world_to_clip(sp, resl, o)
        let (sx, sy, valid) = shadow_pixel(cq, resl)
        let surfd = if valid then target_load(sd, @[sx, sy], 0u32).depth else 1.0
        let wp = world_from_depth(resl, @[f32(sx) + 0.5, ry - (f32(sy) + 0.5)], o, surfd) in
        if shadow_occluded(sp, wp, cq, surfd) then 1.0 else shc


-- Packed grid from driver/src/shadow.rs, retained until geometry or sun changes.
-- Cells contain all intersecting caster IDs, not sampled visibility/depth.
-- Their size affects lookup cost only; analytic box intersections set the edge.
def shadow_sun(grid: []vec4f32) vec3f32 = grid[3].xyz

def grid_box_hit(boxes: []vec4f32, index: i32, p: vec3f32) bool =
  let c = boxes[index * 4]
  let a = boxes[index * 4 + 1]
  let b = boxes[index * 4 + 2]
  let d = boxes[index * 4 + 3]
  let delta = c.xyz - p
  let mid = @[dot(delta, a.xyz), dot(delta, b.xyz), dot(delta, d.xyz)]
  let extent = @[a.w, b.w, d.w]
  -- Negative extents mark slabs parallel to the sun: their unscaled dual
  -- basis tests containment, while the other slabs bound the ray interval.
  let outside = (extent.x < 0.0 && f32.abs(mid.x) > 0.0 - extent.x)
             || (extent.y < 0.0 && f32.abs(mid.y) > 0.0 - extent.y)
             || (extent.z < 0.0 && f32.abs(mid.z) > 0.0 - extent.z)
  let lo = @[if extent.x < 0.0 then -1.0e30 else mid.x - extent.x,
             if extent.y < 0.0 then -1.0e30 else mid.y - extent.y,
             if extent.z < 0.0 then -1.0e30 else mid.z - extent.z]
  let hi = @[if extent.x < 0.0 then 1.0e30 else mid.x + extent.x,
             if extent.y < 0.0 then 1.0e30 else mid.y + extent.y,
             if extent.z < 0.0 then 1.0e30 else mid.z + extent.z]
  let enter = f32.max(lo.x, f32.max(lo.y, lo.z))
  let leave = f32.min(hi.x, f32.min(hi.y, hi.z)) in
  !outside && leave >= f32.max(enter, 0.006)

def sun_shadow(grid: []vec4f32, p: vec3f32, _n: vec3f32) f32 =
  let right = grid[1]
  let up = grid[2]
  let side = i32(grid[0].z)
  let ij = @[dot(p, right.xyz) - right.w, dot(p, up.xyz) - up.w] * grid[0].w
  let x = i32(f32.floor(ij.x))
  let y = i32(f32.floor(ij.y)) in
  if x < 0 || x >= side || y < 0 || y >= side then 0.0
  else
    let header = grid[4 + y * side + x]
    let start = i32(header.x)
    let end = start + i32(header.y)
    let id_base = i32(grid[0].x)
    let box_base = i32(grid[0].y)
    let (_, blocked) = loop (i, blocked) = (start, false) while i < end && !blocked do
      let packed = grid[id_base + i / 4]
      let id = i32(if i % 4 == 0 then packed.x else if i % 4 == 1 then packed.y
                   else if i % 4 == 2 then packed.z else packed.w) in
      (i + 1, grid_box_hit(grid, box_base / 4 + id, p)) in
    if blocked then 1.0 else 0.0

-- Four fixed subpixel samples cover the receiving surface's local plane.
-- Each sample selects its own grid cell, so coverage remains correct at cell
-- boundaries and overlapping casters combine by visibility, not by max alpha.
def sun_shadow_aa(grid: []vec4f32, p: vec3f32, n: vec3f32,
                  resolution: vec3f32, camera: orbit) f32 =
  let eye = cam_eye(camera)
  let forward = normalize(camera.target - eye)
  let right = normalize(cross(forward, @[0.0, 1.0, 0.0]))
  let up = cross(right, forward)
  let q = p - eye
  let raw = dot(n, q)
  let minimum = magnitude(q) * 0.02
  let denominator = if f32.abs(raw) > minimum then raw
                    else if raw < 0.0 then 0.0 - minimum else minimum
  let quarter_pixel = f32.max(dot(q, forward), 0.0) * (0.5 * f32.tan(f32.radians(FOV * 0.5))) / resolution.y
  let dx = (right - q * (dot(n, right) / denominator)) * quarter_pixel
  let dy = (up - q * (dot(n, up) / denominator)) * quarter_pixel in
  (sun_shadow(grid, p - dx - dy, n) + sun_shadow(grid, p + dx - dy, n)
   + sun_shadow(grid, p - dx + dy, n) + sun_shadow(grid, p + dx + dy, n)) * 0.25
