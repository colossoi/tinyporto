-- camera: orbit camera ray generation for the tilted-diorama view.
-- Ported/adapted from mountains.wyn, in world meters with ground at y = 0.
-- Library module: no `open` (see math.wyn for the idiom); f32.* qualified.

import "pkg:gfx"

-- View tuning. The telephoto FOV gives the "tiny diorama" compression; the orbit
-- target / distance / angles are per-frame state the host drives (see `orbit`).
def FOV: f32 = 20.0
def LOOKAT: vec3f32 = @[0.0, 0.0, 0.0]   -- sun-shadow map centre (shadow.wyn's sun camera aims here)

-- The orbit camera state the host drives: a focal `target` on/near the ground, an
-- `az` (azimuth, horizontal orbit), an `elev` (pitch; negative keeps the eye above
-- the y=0 ground), and a `dist` (eye distance from the target). Distance and pitch
-- are independent — the host maps scroll to `dist` and right-drag to `az`/`elev`.
type orbit = { target: vec3f32, az: f32, elev: f32, dist: f32 }

def shared_orbit(o: orbit) gfx.camera.orbit.state = {
  target = o.target,
  azimuth = o.az,
  elevation = o.elev,
  distance = o.dist,
}

-- World-space camera eye for an orbit. The single source for the orbit position;
-- get_ray and world_to_clip both build their eye from it.
def cam_eye(o: orbit) vec3f32 =
  gfx.camera.orbit.eye(shared_orbit(o))

-- Primary ray for a fragment. Returns (ro, rd) in world space.
def get_ray(resolution: vec3f32, fragCoord: vec2f32, o: orbit) (vec3f32, vec3f32) =
  let direction = gfx.camera.ray_direction(FOV, resolution.xy, fragCoord) in
  gfx.camera.orbit.ray(direction, shared_orbit(o))

-- Intersect a ray with the y = 0 ground plane. Returns t (<0 if pointing away).
def ground_t(ro: vec3f32, rd: vec3f32) f32 =
  if f32.abs(rd.y) < 1e-6 then 0.0 - 1.0
  else 0.0 - ro.y / rd.y

------------------------------------------------------------
-- View-projection for rasterizing geometry (M1+).
-- Matrices are column-major (outer arrays = columns), matching mountains.wyn's
-- mat3 convention and the SPIR-V emission. RH view, z in [0,1] (wgpu/Vulkan).
------------------------------------------------------------

-- Clip near/far planes (metres). world_to_clip / linear_depth share these so a
-- stored NDC depth inverts back to a metric distance consistently.
def CLIP_NEAR: f32 = 0.1
def CLIP_FAR:  f32 = 1000.0

-- World position -> clip space. Applies view then projection (no mat*mat).
def world_to_clip(p: vec3f32, resolution: vec3f32, o: orbit) vec4f32 =
  let aspect = resolution.x / resolution.y in
  let eye = cam_eye(o) in
  let view = gfx.camera.look_at(eye, o.target, @[0.0, 1.0, 0.0]) in
  let projection = gfx.camera.perspective(FOV, aspect, CLIP_NEAR, CLIP_FAR) in
  gfx.camera.world_to_clip(p, view, projection)

-- Linear view-forward distance (metres, +toward the scene) from a stored NDC depth
-- d = clip.z / clip.w. The exact inverse of perspective()'s z map for our RH,
-- z in [0,1] projection, so contact-shadow depth compares in real metres.
def linear_depth(d: f32) f32 =
  gfx.camera.linear_depth(d, CLIP_NEAR, CLIP_FAR)

-- World position of the surface at `fragCoord` (pixel centre, y measured bottom-up
-- like get_ray) given its stored NDC depth `d`. Reconstructs the eye ray and walks
-- it out to the linear distance the depth encodes. Inverse of the rasterized
-- world_to_clip for on-surface points.
def world_from_depth(resolution: vec3f32, fragCoord: vec2f32, o: orbit, d: f32) vec3f32 =
  let (ro, rd) = get_ray(resolution, fragCoord, o) in
  let fwd = normalize(o.target - ro) in
  gfx.camera.world_position_from_depth(
    ro, rd, fwd, d, CLIP_NEAR, CLIP_FAR)

-- Does a clip-space centre with bounding SPHERE world-radius `r` touch the view
-- frustum? Keeping the clip-space form separate lets callers reuse the projection
-- for later screen-space tests such as coarse occlusion.
def frustum_keep_clip(c: vec4f32, r: f32, resolution: vec3f32) bool =
  gfx.camera.frustum_contains_sphere(
    c, r, FOV, resolution.x / resolution.y, 0.1)

-- World-space convenience wrapper for callers that do not otherwise need clip.
def frustum_keep(p: vec3f32, r: f32, resolution: vec3f32, o: orbit) bool =
  frustum_keep_clip(world_to_clip(p, resolution, o), r, resolution)
