-- Directional daylight and a small analytic sun, under a static cloud sheet.
-- A value-noise field supplies cloud coverage; the sheet has no camera parallax.
-- Noise supplied by wyn/noise; FBM shaping adapted from Shadertoy "Clouds": https://www.shadertoy.com/view/lss3zr

import "pkg:noise"
import "math"
import "shade"

module clouds = {

  -- Noise basis matrix (column-major: outer arrays are columns).
  def basis: mat3f32 =
    @[[ 0.00,  0.80,  0.60],
      [-0.80,  0.36, -0.48],
      [-0.60, -0.48,  0.64]]

  -- wyn/noise normalizes value noise to [-1,1]; cloud density expects [0,1].
  def noise01(x: vec3f32) f32 =
    0.5f32 + 0.5f32 * fhnoise.value3(fasthash.seed(0xC10D5EEDu32), x)

  -- Fractal Brownian motion (3 octaves).
  def fbm(p0: vec3f32) f32 =
    let f0 = 0.5 * noise01(p0)
    let p1 = basis * p0 * 2.02
    let f1 = f0 + 0.25 * noise01(p1)
    let p2 = basis * p1 * 2.03 in
    f1 + 0.125 * noise01(p2)

  -- A cloud layer at infinity, addressed by ray DIRECTION. Dividing the horizontal
  -- direction by (rd.y + HORIZ) projects it onto a plane whose apparent horizon sits
  -- at rd.y = -HORIZ: features compress without bound approaching it, so clouds
  -- foreshorten and read edge-on near the horizon just like a real cloud sheet — and
  -- being at infinity they have zero parallax (fixed in world as the camera orbits).
  -- HORIZ = 0 keeps clouds strictly above the true horizon, so the finite ground
  -- plate (a plane at y=0, always below the horizon) can never intrude into them.
  def HORIZ:   f32 = 0.0
  def SCALE:   f32 = 0.55
  -- Linear HDR, tone mapped only by the final surface pass. The lower haze
  -- retains the old display colour after ACES; the sky keeps its blue headroom.
  def HORIZON: vec3f32 = @[0.84, 1.07, 1.57]
  def VOID:    vec3f32 = @[0.396, 0.326, 0.266]
  def LIT:     vec3f32 = @[1.50, 1.55, 1.60]
  def DARK:    vec3f32 = @[0.55, 0.64, 0.90]

  -- Art direction: three times the terrestrial angular diameter. This controls
  -- appearance only; the disk centre and all lighting still share one direction.
  def SUN_SIZE: f32 = 3.0
  def SUN_RADIUS: f32 = 0.0046517 * SUN_SIZE

  -- Art-directed angular scattering approximation: no marching, LUTs or pow.
  -- Horizontal alignment fades naturally at the zenith (no azimuth singularity).
  def clear_sky(rd: vec3f32, sun: vec3f32) vec3f32 =
    let horizontal = dot(rd.xz, sun.xz) / f32.max(magnitude(sun.xz), 0.001)
    let facing = smoothstep(-0.65, 0.65, horizontal)
    -- Away hue follows an offline Hosek-Wilkie XYZ sample at our sun elevation
    -- (T=2, albedo=.1), exposed to blue=.30: about #4C7EB1 after ACES/sRGB.
    let zenith = mix(@[0.0681, 0.1460, 0.30], @[0.32, 0.50, 1.10], facing)
    let horizon = HORIZON + @[0.055, 0.04, 0.015] * horizontal
    -- The orbit camera sees only 0..8 degrees above the horizon. Compress the
    -- pale haze into a narrow band so the directional blue is visible in play.
    -- This vertical shaping is art direction, not the reference sky model.
    let height = f32.max(rd.y, 0.0)
    let gradient = mix(horizon, zenith, height / (height + 0.004))
    let delta = rd - sun
    let angle2 = dot(delta, delta)
    -- Broad forward haze and a compact aureole, fixed in world space.
    let glow = 0.10 / (1.0 + 180.0 * angle2)
                 + 1.2 / (1.0 + (50000.0 / (SUN_SIZE * SUN_SIZE)) * angle2)
    let daylight = smoothstep(0.0, 0.04, sun.y) in
    gradient + SUN_COLOR * (0.5 * glow * daylight)

  def solar_disk(rd: vec3f32, sun: vec3f32, pixel_angle: f32) vec3f32 =
    let delta = rd - sun
    let angle2 = dot(delta, delta)
    let radius2 = SUN_RADIUS * SUN_RADIUS
    let edge = f32.max(SUN_RADIUS * pixel_angle, 0.000000001) in
    if sun.y <= 0.0 || angle2 > radius2 + edge then v3(0.0)
    else
      let mask = 1.0 - smoothstep(radius2 - edge, radius2 + edge, angle2)
      let limb = 0.55 + 0.45 * f32.sqrt(f32.max(0.0, 1.0 - angle2 / radius2)) in
      SUN_COLOR * (3.0 * limb * mask)

  -- Cloud coverage at a projected plane coordinate. Two fbm octaves give big soft
  -- masses broken by finer detail; the threshold makes them puffy, not overcast.
  def coverage(uv: vec2f32) f32 =
    let p    = @[uv.x, 0.0, uv.y]
    let big  = fbm(p * SCALE)
    let fine = fbm(p * (SCALE * 3.0)) in
    f32.clamp((big + 0.40 * fine - 0.56) * 3.3, 0.0, 1.0)

  -- Reuse the existing noise once for both sky coverage and solar transmission.
  -- cloud_settings.xy is a demo offset; .z is coverage strength (normally 1).
  def composite(rd: vec3f32, sun: vec3f32, disk: vec3f32,
                cloud_settings: vec3f32) vec3f32 =
    let e = rd.y + HORIZ in
    if e <= 0.0 then VOID
    else
      let grad = clear_sky(rd, sun)
      let uv   = @[rd.x, rd.z] * (1.0 / e)     -- planar projection; blows up at the horizon
      let cov  = if cloud_settings.z <= 0.0 then 0.0
                 else coverage(uv + cloud_settings.xy) * cloud_settings.z
      let fade = f32.clamp(e * 10.0, 0.0, 1.0)  -- ease clouds in above the horizon
      let shade = mix(DARK, LIT, f32.clamp(cov * 1.3, 0.0, 1.0))
      let transmission = 1.0 - cov * fade
      let t2 = transmission * transmission in
      mix(grad, shade, cov * fade) + disk * (t2 * t2)

  -- GI and water already evaluate direct sunlight separately. Keep the compact
  -- emitter out of their sky samples to avoid double energy and GI fireflies.
  def sky(rd: vec3f32, sun: vec3f32) vec3f32 =
    composite(rd, sun, v3(0.0), @[0.0, 0.0, 1.0])

  def visible_sky(rd: vec3f32, sun: vec3f32, pixel_angle: f32,
                  cloud_settings: vec3f32) vec3f32 =
    composite(rd, sun, solar_disk(rd, sun, pixel_angle), cloud_settings)
}
