-- tiny porto — root shader module.
--
-- Ground painting as an ordered list of parametric items. Two tools:
--   tool 0 / kind 2  fence    — thin ribbon along a curve
--   tool 1 / kind 3  building — fixed-size rectangle plunked on click
-- Strokes capture control points online (Reumann-Witkam) and render through a
-- Catmull-Rom curve. Z-order is order of addition.
--
-- Ground ribbons and rounded-box props fill a shared G-buffer. Deferred lighting
-- combines that surface data with sunlight, ambient occlusion, and sky.
-- Sett placement lives in bricks.wyn; surface textures in material.wyn.
--
-- Idiom: root does `open f32`; library modules pulled in via bare `import`.

open f32
import "math"
import "camera"
import "shade"
import "paint"
import "input"
import "bricks"
import "walls"
import "shadow"
import "pkg:gtao"
import "clouds"
import "hiz"
import "gi"
import "ray"
import "render_types"
import "material"
import "terrain"
import "banks"
import "water"
import "water_reflection"
import "pkg:gfx"

-- Per-frame globals: one std140 #[uniform] block the host fills once and every
-- entry binds at (set=1, binding=0). Continuous state lives here; discrete input
-- (keys, mouse buttons, cursor motion, wheel) arrives as the `events` stream that
-- update_world folds. Members:
--   resolution  (width, height, aspect)
--   mods        LIVE modifier mask at frame time (bit0 shift, 1 ctrl, 2 alt, 3
--               super) — the "held right now" query, distinct from an event's own
--               captured mods.
--   cam_*       the orbit camera the host drives (target, azimuth, elevation,
--               distance) — see camera.orbit.
type frame_globals = {
  resolution: vec3f32,
  mods: u32,
  cam_target: vec3f32,
  cam_az: f32,
  cam_elev: f32,
  cam_dist: f32,
  time: f32,          -- seconds since start, animates waves and water lighting
  previous_target: vec3f32,
  previous_az: f32,
  previous_elev: f32,
  previous_dist: f32,
  frame_index: u32,
  history_valid: u32,
  gi_mode: u32,       -- 0 = GI, 1 = original ambient, 2 = indirect, 3 = reference
  textures_enabled: u32,
  sky_clouds: vec3f32, -- screenshot sky demo: cloud offset xy, coverage strength z
}

-- The orbit camera the host drives, unpacked from the frame block. Built locally
-- wherever the camera is used (kept out of `map` lambdas as an outer capture).
def camera_from_frame(frame: frame_globals) orbit =
  { target = frame.cam_target, az = frame.cam_az, elev = frame.cam_elev, dist = frame.cam_dist }

def previous_camera_from_frame(frame: frame_globals) orbit =
  { target = frame.previous_target, az = frame.previous_az,
    elev = frame.previous_elev, dist = frame.previous_dist }

-- Persistent painter state: UI, control points, paint items, and stroke capture.
-- Input helpers decode events; update_world folds them into the next state.
type world = { ui: []f32, points: []vec2f32, items: []vec4f32, head: []f32 }

-- The ground draw reads the control points and packed items through this view.
type painted = { points: []vec2f32, items: []vec4f32 }

-- The unified graphics vocabulary treats indirect commands as ordinary values.
-- These fields are the WebGPU non-indexed indirect-draw ABI, but their data flow
-- and production remain wholly inside Wyn.
type draw_command = {
  vertex_count: u32,
  instance_count: u32,
  first_vertex: u32,
  first_instance: u32,
}

type visibility = {
  prop_inst: []prop,
  draw: draw_command,
}

type lighting_inputs = {
  scene: render_target<gbuffer>,
  sun_grid: []vec4f32,
  ao_work: []vec4f32,
  indirect: []gi.sample,
  waves: []vec4f32,
}

def append_captured_points(previous_points: []vec2f32, existing_point_count: i32,
                           capture: stroke_capture) []vec2f32 =
  map(|i| if i >= existing_point_count && i - existing_point_count < capture.emitted_count
          then capture.emitted[i - existing_point_count] else previous_points[i], iota(POINTS_CAP))

def create_or_extend_item(previous_items: []vec4f32, head: stroke_head,
                          capture: stroke_capture, tool: f32) []vec4f32 =
  map(|i| if capture.pressed > 0.5 && i == head.item_count then
            pack_paint_item({ kind = item_kind_for_tool(tool), point_start = head.point_count,
                              point_count = capture.emitted_count, param = stroke_half_width(tool) })
          else if capture.pressed < 0.5 && capture.emitted_count > 0i32 && i == head.item_count - 1i32 then
            let item = paint_item_from_packed(previous_items[i]) in
            pack_paint_item({ kind = item.kind, point_start = item.point_start,
                              point_count = item.point_count + capture.emitted_count, param = item.param })
          else previous_items[i], iota(ITEMS_CAP))

-- Apply UI shortcuts, capture stroke points, and create or extend the current item.
def update_world(frame: frame_globals, events: []vec4f32, previous_world: world) world =
  let ui = ui_state_from_buffer(previous_world.ui)
  let head = stroke_head_from_buffer(previous_world.head)
  -- Use one tool for the whole batch: UI and stroke events are folded separately,
  -- so a tool change takes effect on the next frame.
  let next_ui = apply_ui_shortcuts(ui, events)
  let capture = capture_stroke_points(
    head, events, frame.resolution, camera_from_frame(frame), is_building(ui.tool)) in
  { ui = pack_ui_state(next_ui),
    points = append_captured_points(previous_world.points, head.point_count, capture),
    items = create_or_extend_item(previous_world.items, head, capture, ui.tool),
    head = pack_stroke_head(record_capture_progress(head, capture, gi.EDIT_TRACK_FRAMES)) }

------------------------------------------------------------
-- Coarse-depth occlusion. Each tile stores the nearest surface depth from the
-- previous frame. Prop visibility compares projected candidates with those tiles.
-- OCC_TILE and the coarse-grid dimensions live in hiz.wyn.
------------------------------------------------------------

-- In the unified pipeline model the scene targets arrive as typed
-- `render_target` values on the root entry.  Coarse occlusion history and GTAO
-- working values are ordinary arrays; the compiler owns their physical storage
-- and schedules the graphics/compute dependencies implied by value flow.

------------------------------------------------------------
-- Cull (Nine's simple path). A lightweight predicate filters original candidate
-- indices — cobble setts first, then wall bricks/quoins/grout. Only surviving indices
-- are resolved into complete `prop` records, so rejected candidates pay no basis,
-- roundness, colour, or draw cost. Output 0 = prop_inst, output 1 = prop_args.
------------------------------------------------------------

-- The prop domain: cobble setts, building masonry, then bank ashlar and coping.
def PROP_SETTS: i32 = BCOLS * BROWS
def PROP_WALLS: i32 = BRICK_SLOTS + QUOIN_SLOTS + GROUT_SLOTS
def PROP_SLOTS: i32 = PROP_SETTS + PROP_WALLS + banks.COUNT

-- Wall visibility tests each live block against the camera frustum.
def wall_visible(frame: frame_globals, wall_brick_index: i32) bool =
  let brk = wall_brick(wall_brick_index)
  let center = brk.center in
  if center.y <= 0.0 then false
  else frustum_keep(center, magnitude(brk.half), frame.resolution, camera_from_frame(frame))

-- One surviving wall block. Blocks carry their own half-extents and a yaw; a tiny
-- corner radius keeps the edges crisp. `kind` (0 brick, 1 quoin, 2 grout) selects
-- colour and surface material carried into the draw stream.
def wall_prop(wall_brick_index: i32) prop =
  let brk = wall_brick(wall_brick_index)
  let center = brk.center
  let (right, up, fwd) = gfx.transform.yaw_basis(brk.yaw)
  let kind = f32(brk.kind)
  -- Tone seeds from the stable, baked centre — bricks mix two fired-clay tones by a
  -- position hash; quoins are pale limestone with only a faint lightness wobble.
  let cv = brick_hash(i32(center.x * 53.0 + center.z * 131.0 + center.y * 311.0 + 10000.0))
  let hue = brick_hash(i32(center.x * 97.0 + center.z * 57.0 + center.y * 181.0 + 10000.0))
  let albedo = if kind > 1.5 then GROUT_COLOR
               else if kind > 0.5 then QUOIN_COLOR * v3(0.90 + 0.16 * cv)
               else mix(BRICK_BASE, BRICK_BASE2, hue) * v3(0.80 + 0.40 * cv)
  in
  { center = center, radius = 0.004, half = brk.half,
    right = right, up = up, fwd = fwd, albedo = albedo,
    material = if brk.kind == 2u32 then material.MORTAR
               else if brk.kind == 1u32 then material.LIMESTONE else material.BRICK }

-- Filter original candidate indices before constructing their full prop records.
def prop_index_visible(frame: frame_globals, cells: []vec4f32,
                        occlusion_depth: []f32, candidate_index: i32) bool =
  if candidate_index < PROP_SETTS then
    terrain.land(cells, sett_center(candidate_index))
      && sett_visible(frame.resolution, camera_from_frame(frame), occlusion_depth, candidate_index)
  else if candidate_index < PROP_SETTS + PROP_WALLS then wall_visible(frame, candidate_index - PROP_SETTS)
  else
    let i = candidate_index - PROP_SETTS - PROP_WALLS in
    if !banks.active(cells, i) then false
    else let p = banks.stone(cells, i) in
      frustum_keep(p.center, magnitude(p.half), frame.resolution, camera_from_frame(frame))

def prop_from_index(cells: []vec4f32, candidate_index: i32) prop =
  if candidate_index < PROP_SETTS then sett_prop(candidate_index)
  else if candidate_index < PROP_SETTS + PROP_WALLS then wall_prop(candidate_index - PROP_SETTS)
  else banks.stone(cells, candidate_index - PROP_SETTS - PROP_WALLS)

def prop_draw(instance_count: i32) draw_command =
  { vertex_count = BOX_FRONT_VERTICES, instance_count = u32(instance_count),
    first_vertex = 0u32, first_instance = 0u32 }

def cull_props(frame: frame_globals, cells: []vec4f32,
                occlusion_depth: []f32) visibility =
  let live_indices =
    filter(|i| prop_index_visible(frame, cells, occlusion_depth, i), iota(PROP_SLOTS))
  let live = map(|i| prop_from_index(cells, i), live_indices) in
  { prop_inst = live, draw = prop_draw(length(live_indices)) }

-- Submit mesh tiles only for wet cells touching the view. The sphere includes
-- the entire cell and the maximum wave displacement, so culling cannot open seams.
def cull_water(frame: frame_globals, cells: []vec4f32) ([]i32, draw_command) =
  let live = filter(|i|
    let p = terrain.center(i) in cells[i].w != 1.0
      && frustum_keep(@[p.x, terrain.WATER_Y, p.y], 0.72,
                      frame.resolution, camera_from_frame(frame)), iota(terrain.COUNT)) in
  (live, { vertex_count = u32(water.VERTICES_PER_CELL), instance_count = u32(length(live)),
           first_vertex = 0u32, first_instance = 0u32 })

-- Minimum depth per coarse tile, saved for next frame's visibility tests.
-- Clamp reads at partial edge tiles so out-of-bounds depth cannot fake an occluder.
def occ_reduce_tile(scene: render_target<gbuffer>, resolution: vec3f32,
                    tile: vec2i32) f32 =
  let mx = i32(resolution.x) - 1
  let my = i32(resolution.y) - 1
  let tx = tile.x
  let ty = tile.y
  let m =
    loop m = 1.0 for k < 64 do
      let sx = i32.clamp(tx * OCC_TILE + (k % OCC_TILE), 0, mx)
      let sy = i32.clamp(ty * OCC_TILE + (k / OCC_TILE), 0, my)
      let v = target_load(scene, @[sx, sy], 0u32).depth in
      f32.min(m, v) in
  m

------------------------------------------------------------
-- Deferred G-buffer. The scene fragments
-- write a thin G-buffer (albedo, world normal,
-- window depth) as MRT targets. Deferred lighting resolves opaque geometry;
-- the water mesh shades directly over it.
-- g_albedo.w packs roughness (0 = sky).
------------------------------------------------------------

-- Project tessellated ground vertices and write their surface data to the G-buffer.
type scene_varying = { kind: f32, attr: f32, normal: vec3f32, world: vec3f32 }

-- Derive the requested ground vertex directly from the previous painted state,
-- then project it.  The tessellation domain has exactly one consumer with the
-- same vertex index, so a materialized intermediate stream is unnecessary.
def scene_vertex(frame: frame_globals, painted_scene: painted,
                 vertex_index: u32,
                 _instance_index: u32, _draw_index: u32)
  vertex<scene_varying> =
  let vid = i32(vertex_index)
  let bed = vid >= TESS_CAP
  let v = ground_vertex_at(if bed then vid - TESS_CAP else vid, painted_scene.items, painted_scene.points)
  let p = if bed then @[v.pos.x, terrain.BED_Y, v.pos.z] else v.pos in
  vertex_output(
    world_to_clip(p, frame.resolution, camera_from_frame(frame)),
    { kind = if bed then -1.0 else v.kind, attr = v.attr, normal = v.nrm, world = p })

def item_color(kind: f32) vec3f32 =
  if kind < 0.5 then SAND_COLOR
  else if kind < 2.5 then WALL_COLOR
  else BUILDING_COLOR

-- Clip land/paint against the cell boundary and write unlit surface data.
-- G-buffer write for the ground: albedo (material color + stroke edging, pre-light)
-- @0, world normal @1, window depth @2 (also feeds the Hi-Z pyramid). No lighting.
def scene_fragment(cells: []vec4f32, value: scene_varying, position: vec4f32,
                    _front_facing: bool, _primitive_index: u32, _sample_index: u32) fragment_output<gbuffer> =
  let kind = value.kind
  let attr = value.attr
  let normal = value.normal
  let nrm = normalize(normal)
  let base = if kind < 0.0 then terrain.BED_COLOR else item_color(kind)
  let edge = smoothstep(0.78, 1.0, f32.abs(attr))
  let surf = mix(base, OUTLINE_COLOR, edge * 0.5) in
  if kind >= 0.0 && !terrain.land(cells, value.world.xz) then #discard
  else #depth({ albedo = @[surf.x, surf.y, surf.z, 1.0],
                normal = octahedral.encode(nrm), depth = position.z }, position.z)

------------------------------------------------------------
-- Props: instanced proxy boxes (Tiny-Glade "tons of tiny instances"). Cobble setts
-- and wall bricks/quoins/grout are one stream of `prop` records, so ONE vertex +
-- fragment pair draws them all. `cull_props` first compacts visible candidate indices,
-- then resolves placement, orientation, roundness, and colour only for survivors.
-- The vertex selects the three camera-side box faces (six triangles); the fragment
-- sphere-traces the rounded box inside it, so the silhouette rounds per instance.
-- The proxy's outer extent IS the rounded box's, so the trace starts on its front
-- face. The wall blocks are real occluders for the cobbles.
------------------------------------------------------------

-- Box-local proxy corner -> world, using the instance's own basis and half-extents.
-- `box_pos` has y in [0,1]; centring it (y - 0.5) makes the box tilt about its middle.
def prop_world(prop_instance: prop, local_position: vec3f32) vec3f32 =
  let lc = @[local_position.x * (prop_instance.half.x * 2.0),
             (local_position.y - 0.5) * (prop_instance.half.y * 2.0),
             local_position.z * (prop_instance.half.z * 2.0)] in
  prop_instance.center + gfx.transform.orient(lc, prop_instance.right, prop_instance.up, prop_instance.fwd)

type prop_varying = { world: vec3f32, instance: u32 }

def prop_vertex(frame: frame_globals, prop_instances: []prop,
                vertex_index: u32, instance_index: u32,
                _draw_index: u32) vertex<prop_varying> =
  let vid = i32(vertex_index)
  let iid = i32(instance_index)
  let p = prop_instances[iid]
  let eye = gfx.transform.unorient(cam_eye(camera_from_frame(frame)) - p.center,
                                  p.right, p.up, p.fwd)
  let world = prop_world(p, box_front_pos(vid, eye)) in
  -- `iid` rides through as a varying: it is constant across the primitive, so any
  -- interpolation returns it unchanged, and the fragment re-reads the instance
  -- instead of carrying its whole record through the rasterizer. The compacted
  -- stream contains no center.y <= 0 tombstones.
  vertex_output(
    world_to_clip(world, frame.resolution, camera_from_frame(frame)),
    { world = world, instance = instance_index })

-- Sphere-trace this instance's rounded box from the proxy's front face. On a hit,
-- shade from the SDF normal and write the hit's true depth; on a miss (the ray
-- grazes a rounded-off corner) discard the fragment to carve the silhouette.
def prop_fragment(frame: frame_globals, maps: material.textures, prop_instances: []prop,
                  value: prop_varying) fragment_output<gbuffer> =
  let world = value.world
  let p = prop_instances[i32(value.instance)]
  -- Transform the ray into the instance's orthonormal box basis.
  let rd = normalize(world - cam_eye(camera_from_frame(frame)))
  let ro_local = gfx.transform.unorient(world - p.center, p.right, p.up, p.fwd)
  let rd_local = gfx.transform.unorient(rd, p.right, p.up, p.fwd)
  let (t, nl, hit) = ray.rounded_box(ro_local, rd_local, p.half, p.radius, 24, 0.0004)
  let pos = world + rd * t in
  if hit then
    let local = ro_local + rd_local * t
    let seed = i32(p.center.x * 53.0 + p.center.z * 131.0 + p.center.y * 311.0 + 10000.0)
    let footprint = 2.0 * f32.tan(f32.radians(10.0)) * distance(pos, cam_eye(camera_from_frame(frame)))
                    / (frame.resolution.y * f32.max(0.15, f32.abs(dot(nl, rd_local))))
    let surface = if frame.textures_enabled != 0u32 then
                    material.evaluate(maps, p.material, seed, local, p.half, nl, p.albedo, footprint)
                  else { albedo = p.albedo, normal = nl, roughness = 1.0 }
    let n = gfx.transform.orient(surface.normal, p.right, p.up, p.fwd)
    let clip = world_to_clip(pos, frame.resolution, camera_from_frame(frame))
    let d = clip.z / clip.w in
    -- G-buffer: albedo/roughness @0, world normal @1, depth @2 + frag_depth.
    #depth(
      { albedo = @[surface.albedo.x, surface.albedo.y, surface.albedo.z, 0.5 + 0.5 * surface.roughness],
        normal = octahedral.encode(n),
        depth = d },
      d)
  else
    #discard

------------------------------------------------------------
-- Shared masonry for reflections and the on-change shadow geometry export.
-- Empty slots have a negative radius and emit degenerate triangles.
------------------------------------------------------------

def masonry_prop(cells: []vec4f32, i: i32) prop =
  let active = if i < PROP_WALLS then wall_brick(i).center.y > 0.0
               else banks.active(cells, i - PROP_WALLS) in
  if active then prop_from_index(cells, i + PROP_SETTS)
  else { center = v3(0.0), radius = -1.0, half = v3(0.0),
         right = v3(0.0), up = v3(0.0), fwd = v3(0.0), albedo = v3(0.0), material = 0u32 }

-- Dead masonry slots collapse to empty triangles. A
-- separate serial compaction costs more than drawing these coarse boxes.
-- All face orientations participate, including those in shade.
def reflection_vertex(frame: frame_globals, masonry: []prop, vertex_index: u32,
                        instance_index: u32, _draw_index: u32) vertex<water_reflection.varying> =
  let p = masonry[i32(instance_index)] in
  if p.radius < 0.0 || p.center.y + p.half.y < terrain.WATER_Y then vertex_output(@[2.0, 2.0, 2.0, 1.0],
    { point = v3(0.0), normal = @[0.0, 1.0, 0.0], albedo = v3(0.0) })
  else
    let world = prop_world(p, box_pos[i32(vertex_index)])
    let face = i32(vertex_index) / 6
    let n = if face == 0 then p.up else if face == 1 then p.up * -1.0
            else if face == 2 then p.right else if face == 3 then p.right * -1.0
            else if face == 4 then p.fwd else p.fwd * -1.0 in
    vertex_output(water_reflection.project(world, frame.resolution, camera_from_frame(frame)),
                   { point = world, normal = n, albedo = p.albedo })

-- Perspective constants for GTAO, built from the live viewport + camera FOV (vertical
-- 20°) and clip planes. Frame 0: no temporal accumulation (we have no TAA), so the
-- per-pixel noise is static and the denoise pass cleans it up spatially.
def gtao_consts(resolution: vec3f32) gtao.consts =
  gtao.make_constants(@[resolution.x, resolution.y], f32.tan(f32.radians(10.0)),
                      CLIP_NEAR, CLIP_FAR, 0u32, gtao.default_settings)

-- Linearize scene_depth (NDC) to viewspace depth. Sky (far plane) is pinned
-- to CLIP_FAR so it stays finite and never reads as an occluder.
def gtao_scene_vdepth(scene: render_target<gbuffer>, constants: gtao.consts,
                     pixel: vec2i32) f32 =
  let ndc = target_load(scene, pixel, 0u32).depth in
  if ndc > 0.99999 then CLIP_FAR
  else gtao.clamp_depth(gtao.screen_to_viewspace_depth(ndc, constants))

def gtao_load_scene_vdepth(scene: render_target<gbuffer>, constants: gtao.consts,
                          pixel_x: i32, pixel_y: i32) f32 =
  let cx = i32.clamp(pixel_x, 0i32, i32(constants.viewport_size.x) - 1i32)
  let cy = i32.clamp(pixel_y, 0i32, i32(constants.viewport_size.y) - 1i32) in
  gtao_scene_vdepth(scene, constants, @[cx, cy])

def gtao_load_scene_vdepth_uv(scene: render_target<gbuffer>, constants: gtao.consts,
                             texture_coordinates: vec2f32) f32 =
  gtao_load_scene_vdepth(scene, constants,
                         i32(f32.floor(texture_coordinates.x * constants.viewport_size.x)),
                         i32(f32.floor(texture_coordinates.y * constants.viewport_size.y)))

-- GTAO main (High preset = 3 slices x 3 steps), normals reconstructed from
-- linearized scene depth. Writes raw visibility (.x) + packed denoise edges (.y).
def gtao_main_pixel(scene: render_target<gbuffer>, constants: gtao.consts,
                    pixel: vec2i32) vec4f32 =
  let cz = gtao_load_scene_vdepth(scene, constants, pixel.x, pixel.y)
  let lz = gtao_load_scene_vdepth(scene, constants, pixel.x - 1i32, pixel.y)
  let rz = gtao_load_scene_vdepth(scene, constants, pixel.x + 1i32, pixel.y)
  let tz = gtao_load_scene_vdepth(scene, constants, pixel.x, pixel.y - 1i32)
  let bz = gtao_load_scene_vdepth(scene, constants, pixel.x, pixel.y + 1i32)
  let nrm = gtao.viewspace_normal_from_depths(pixel, cz, lz, rz, tz, bz, constants)
  let packed_edges = gtao.pack_edges(gtao.calculate_edges(cz, lz, rz, tz, bz))
  let p = gtao.setup_pixel(pixel, cz, constants)
  let noise = gtao.spatiotemporal_noise(@[u32(pixel.x), u32(pixel.y)], 0u32)
  let visibility =
    loop vis = p.visibility_base for slice < 3 do
      let s = gtao.setup_slice(p, slice, 3, noise.x, nrm) in
      let (hc0, hc1) =
        loop (hc0, hc1) = (s.low_horizon_cos0, s.low_horizon_cos1)
        for step < 3 do
          let (off, _) = gtao.step_sample(p, s, slice, step, 3, noise.y, constants)
          let uv0 = p.nsp + off
          let uv1 = p.nsp - off
          let sz0 = gtao_load_scene_vdepth_uv(scene, constants, uv0)
          let sz1 = gtao_load_scene_vdepth_uv(scene, constants, uv1) in
          gtao.horizon_fold(p, s, uv0, sz0, uv1, sz1, hc0, hc1, constants)
      in
      vis + gtao.slice_visibility(s, hc0, hc1)
  let vis = gtao.finalize_visibility(visibility, 3, constants) in
  @[vis, packed_edges, 0.0, 1.0]

-- Post-scene work is ordinary array computation. The compiler chooses and orders
-- the physical compute stages because both maps read the scene render target and
-- their values feed later work (or the next frame).
def build_postprocess(scene: render_target<gbuffer>, resolution: vec3f32)
  ([]vec4f32, []f32) =
  let w = i32(resolution.x)
  let h = i32(resolution.y)
  let c = gtao_consts(resolution)
  let ao_work =
    map(|i| gtao_main_pixel(scene, c, @[i % w, i / w]), iota(w * h))
  let ow = occ_w(resolution)
  let oh = occ_h(resolution)
  let occ_next =
    map(|i| occ_reduce_tile(scene, resolution, @[i % ow, i / ow]),
        iota(ow * oh)) in
  (ao_work, occ_next)

def load_ao_edges(occlusion_samples: []vec4f32, pixel_x: i32, pixel_y: i32,
                  constants: gtao.consts) vec2f32 =
  let w = i32(constants.viewport_size.x)
  let cx = i32.clamp(pixel_x, 0i32, w - 1i32)
  let cy = i32.clamp(pixel_y, 0i32, i32(constants.viewport_size.y) - 1i32) in
  occlusion_samples[cy * w + cx].xy

def denoise_ao(pixel: vec2i32, occlusion_samples: []vec4f32, constants: gtao.consts)
  (f32, f32) =
  let center = load_ao_edges(occlusion_samples, pixel.x, pixel.y, constants)
  let l  = load_ao_edges(occlusion_samples, pixel.x - 1i32, pixel.y, constants)
  let r  = load_ao_edges(occlusion_samples, pixel.x + 1i32, pixel.y, constants)
  let t  = load_ao_edges(occlusion_samples, pixel.x, pixel.y - 1i32, constants)
  let b  = load_ao_edges(occlusion_samples, pixel.x, pixel.y + 1i32, constants)
  let tl = load_ao_edges(occlusion_samples, pixel.x - 1i32, pixel.y - 1i32, constants)
  let tr = load_ao_edges(occlusion_samples, pixel.x + 1i32, pixel.y - 1i32, constants)
  let bl = load_ao_edges(occlusion_samples, pixel.x - 1i32, pixel.y + 1i32, constants)
  let br = load_ao_edges(occlusion_samples, pixel.x + 1i32, pixel.y + 1i32, constants) in
  gtao.denoise_kernel(center, l, r, t, b, tl, tr, bl, br, constants, true)

-- The GTAO edge-aware denoise (final blur of occlusion_samples) is NOT a separate pass — it
-- reads only gtao_main's output, so `shade_frame_linear` folds it in inline.
------------------------------------------------------------
-- Deferred lighting combines surface colour and normal with ambient occlusion,
-- contact shadows, and geometric sun shadows. Water composition precedes tonemapping.
------------------------------------------------------------

-- Sky shade for a G-buffer miss (alb.w < 0.5), sampled along the pixel's view ray.
-- pixel_center uses bottom-up coordinates.
def shade_sky(resolution: vec3f32, pixel_center: vec2f32, camera: orbit,
              sun: vec3f32, cloud_settings: vec3f32) vec4f32 =
  let (_ro, rd) = get_ray(resolution, pixel_center, camera)
  let pixel_angle = 2.0 * f32.tan(f32.radians(FOV * 0.5)) / resolution.y
  let sc = clouds.visible_sky(rd, sun, pixel_angle, cloud_settings) in
  @[sc.x, sc.y, sc.z, 0.0]

-- Deferred shade for one pixel: read the thin G-buffer at (x,y) and return linear
-- colour. Sky pixels get the cloud sky; lit pixels get GTAO (the edge-aware denoise
-- folded in — it only reads gtao_main's ao_work), the contact march and geometric sun visibility (shadow.wyn), and
-- the AO/shadow-attenuated shade. The image-touching helpers are ordinary defs — the
-- compiler specializes each to its resource global.
def shade_frame_linear(scene: render_target<gbuffer>, sun_grid: []vec4f32,
                occlusion_samples: []vec4f32, indirect: []gi.sample, waves: []vec4f32, frame: frame_globals,
                pixel_x: i32, pixel_y: i32) vec4f32 =
  let sun = shadow_sun(sun_grid)
  let rx = frame.resolution.x
  let ry = frame.resolution.y
  let resl = @[rx, ry, 0.0]
  let o = camera_from_frame(frame)
  let ao_off = (frame.mods & 2u32) != 0u32              -- hold Ctrl to suppress AO
  let g = target_load(scene, @[pixel_x, pixel_y], 0u32)
  let alb = g.albedo
  let fragc = @[f32(pixel_x) + 0.5, ry - (f32(pixel_y) + 0.5)] in    -- pixel centre, bottom-up
  if alb.w < 0.5 then shade_sky(resl, fragc, o, sun, frame.sky_clouds)
  else
    let n = octahedral.decode(g.normal)
    let cd = g.depth
    let pg = world_from_depth(resl, fragc, o, cd)
    let base = @[alb.x, alb.y, alb.z]
    let specular = if frame.textures_enabled == 0u32 then v3(0.0)
                   else sun_specular(n, normalize(cam_eye(o) - pg), f32.clamp(alb.w * 2.0 - 1.0, 0.0, 1.0), sun)
    let ao = if ao_off then 0.0
             else let (aov, _e) = denoise_ao(@[pixel_x, pixel_y], occlusion_samples, gtao_consts(resl)) in 1.0 - aov
    let p = pg + n * SH_LIFT
    let shc = contact_shadow(scene, p, n, resl, o, sun)
    let shm_frac = sun_shadow_aa(sun_grid, pg, n, resl, o)
    let light = if frame.gi_mode == 1u32 || (frame.mods & 4u32) != 0u32 then
      shade_surface_linear(base, n, ao, shc, shm_frac, specular, sun)
    else
      let bounce = gi.resolve(indirect, resl, o, @[pixel_x, pixel_y], pg, n,
                              1.0 - ao, frame.gi_mode == 3u32) in
      shade_surface_gi_linear(base, n, if frame.gi_mode == 3u32 then 0.0 else ao,
                        f32.max(shc, shm_frac), bounce, frame.gi_mode == 2u32, specular, sun)
    let color = water.wet_color(waves, light, pg) in
    @[color.x, color.y, color.z, 1.0]

------------------------------------------------------------
-- Deferred resolve. One fullscreen triangle covers every pixel and its fragment
-- lights that pixel straight to the surface, reading the G-buffer and depth images.
------------------------------------------------------------

-- Fullscreen triangle from the vertex index: (-1,-1), (3,-1), (-1,3) covers the
-- whole clip rect with one primitive (no vertex buffer).
def blit_vertex(vertex_index: u32, _instance_index: u32,
                _draw_index: u32) vertex<()> =
  let vid = i32(vertex_index)
  let x = if vid == 1 then 3.0 else 0.0 - 1.0
  let y = if vid == 2 then 3.0 else 0.0 - 1.0 in
  vertex_output(@[x, y, 0.0, 1.0], ())

def opaque_fragment(inputs: lighting_inputs, frame: frame_globals,
                     _value: (), position: vec4f32,
                     _front_facing: bool, _primitive_index: u32, _sample_index: u32) vec4f32 =
  let xy = @[i32(position.x), i32(position.y)] in
  let opaque = shade_frame_linear(inputs.scene, inputs.sun_grid, inputs.ao_work, inputs.indirect, inputs.waves, frame, xy.x, xy.y)
  let color = tonemap_aces(opaque.xyz) in
  @[color.x, color.y, color.z, 1.0]

-- Shared opaque-depth state for scene and reflection draws. Physical attachments,
-- barriers, pipeline order, and indirect command dependencies are derived from
-- this root operation by the compiler.
def opaque_depth: fragment_state = {
  depth_test = #less_equal,
  depth_write = true,
  blend = #replace,
  color_write = true,
}

def build_gi(scene_image: render_target<gbuffer>, sun_grid: []vec4f32,
                cells: []vec4f32, ambient_occlusion: []vec4f32, gi_in: []gi.sample,
                head_in: []f32, frame: frame_globals)
  ([]gi.sample, []scene_trace.node, []vec4f32, []gi.sample, []gi.sample) =
  -- Tiny Glade's hybrid final gather: detailed screen tracing, BVH fallback,
  -- quarter-resolution rays, SH reconstruction, temporal reuse, recurrent blur.
  -- The reference mode traces explicit paths and bypasses SH/spatial filtering.
  -- Read the retained head, just like the rendered paint: reference invalidation
  -- follows visible edits one frame after capture, without a CPU readback.
  let edit_frames = stroke_head_from_buffer(head_in).edit_frames
  let trace_nodes = map(scene_trace.build_node, iota(scene_trace.NODE_COUNT))
  let radiance = map(|i| gi.screen_radiance(scene_image, sun_grid, trace_nodes, cells,
    ambient_occlusion, gi_in, frame.resolution, camera_from_frame(frame),
    previous_camera_from_frame(frame), frame.history_valid != 0u32,
    frame.gi_mode != 1u32 && frame.gi_mode != 3u32 && (frame.mods & 4u32) == 0u32, i),
    iota(length(ambient_occlusion)))
  let rays = map(|i| gi.trace_pixel(scene_image, sun_grid, trace_nodes, cells, ambient_occlusion,
    radiance, frame.resolution, camera_from_frame(frame), frame.frame_index, i,
    frame.gi_mode != 1u32 && frame.gi_mode != 3u32 && (frame.mods & 4u32) == 0u32),
    iota(gi.trace_width(frame.resolution) * gi.trace_height(frame.resolution)))
  let temporal = map(|i| gi.temporal_pixel(scene_image, sun_grid, trace_nodes, cells,
    ambient_occlusion, radiance, rays, gi_in, frame.resolution, camera_from_frame(frame),
    previous_camera_from_frame(frame), frame.frame_index, frame.history_valid != 0u32, edit_frames,
    frame.gi_mode != 1u32 && (frame.mods & 4u32) == 0u32, frame.gi_mode == 3u32, i),
    iota(length(gi_in)))
  let indirect = map(|i| gi.recurrent_pixel(temporal, frame.resolution,
    camera_from_frame(frame), frame.gi_mode == 3u32, i), iota(length(gi_in))) in
  (indirect, trace_nodes, radiance, rays, temporal)

-- Render the previous world while producing the next one. Visibility also reads
-- the previous frame's coarse depth; this frame's depth becomes next frame's history.
-- The flat input/output tuple is the host ABI; the algorithm uses named records.
def build_water(cells: []vec4f32, time: f32) ([]f32, []vec4f32) =
  let heights = map(|i| water.grid_height(cells, time, i), iota(water.PADDED_SIDE * water.PADDED_SIDE))
  let vertices = map(|i| water.grid_vertex(heights, i), iota(water.SIDE * water.SIDE)) in
  (heights, vertices)

entry tinyporto_frame(
    uistate_in: []f32,
    points_in: []vec2f32,
    items_in: []vec4f32,
    head_in: []f32,
    occ_in: []f32,
    gi_in: []gi.sample,
    terrain_cells: []vec4f32,
    brick_color: texture2d, brick_normal: texture2d,
    stone_color: texture2d, stone_normal: texture2d,
    mortar_color: texture2d, mortar_normal: texture2d,
    material_sampler: sampler,
    reflection_sampler: sampler,
    events: []vec4f32,
    frame: frame_globals,
    shadow_grid: []vec4f32,
    reflection: render_target<vec4f32>,
    scene: render_target<gbuffer>,
    surface: render_target<vec4f32>)
    ([]f32, []vec2f32, []vec4f32, []f32, []f32, []gi.sample,
     []scene_trace.node, []vec4f32, []gi.sample, []gi.sample,
     []vec4f32, render_target<gbuffer>, render_target<vec4f32>, []vec4f32, []f32,
     render_target<vec4f32>) =
  let next_world = update_world(frame, events, { ui = uistate_in, points = points_in, items = items_in, head = head_in })
  let visible = cull_props(frame, terrain_cells, occ_in)
  let masonry = map(|i| masonry_prop(terrain_cells, i), iota(PROP_WALLS + banks.COUNT))
  let (wave_heights, wave_vertices) = build_water(terrain_cells, frame.time)
  let maps = { brick_color = brick_color, brick_normal = brick_normal,
               stone_color = stone_color, stone_normal = stone_normal,
               mortar_color = mortar_color, mortar_normal = mortar_normal,
               filtering = material_sampler }


  let reflection_pixels = rasterize_triangles(direct_draw(3u32, 1u32), blit_vertex)
  let reflection_sky = shade(reflection, reflection_pixels,
    |_, position, _, _, _| water_reflection.sky(frame.resolution, camera_from_frame(frame), position, shadow_sun(shadow_grid)))
  let reflection_triangles = rasterize_triangles(direct_draw(36u32, u32(PROP_WALLS + banks.COUNT)),
    reflection_vertex(frame, masonry, _, _, _))
  let reflected_scene = shade_with(opaque_depth, reflection_sky, reflection_triangles,
    |value, position, _, _, _| water_reflection.fragment(shadow_grid, frame.resolution, value, position))

  -- Fill the scene G-buffer with the ground, then the visible props.
  let ground_triangles = rasterize_triangles(
    direct_draw(u32(TESS_CAP + 6), 1u32),
    scene_vertex(frame, { points = points_in, items = items_in }, _, _, _))
  let ground_image = shade_with(opaque_depth, scene, ground_triangles, scene_fragment(terrain_cells, _, _, _, _, _))
  let prop_triangles = rasterize_triangles(
    indirect_draw(visible.draw), prop_vertex(frame, visible.prop_inst, _, _, _))
  let scene_image = shade_with(
    opaque_depth, ground_image, prop_triangles,
    |value, _, _, _, _| prop_fragment(frame, maps, visible.prop_inst, value))

  -- Estimate ambient occlusion and save coarse depth for the next frame.
  let (ambient_occlusion, next_occlusion) = build_postprocess(scene_image, frame.resolution)

  let (indirect, trace_nodes, radiance, rays, temporal) =
    build_gi(scene_image, shadow_grid, terrain_cells, ambient_occlusion, gi_in, head_in, frame)

  -- Resolve opaque lighting, then shade the visible water mesh directly into
  -- the same image. Each surface is tone mapped once; the coarse reflection
  -- capture remains linear until it is sampled here.
  let pixels = rasterize_triangles(direct_draw(3u32, 1u32), blit_vertex)
  let opaque_image = shade(surface, pixels,
    opaque_fragment({ scene = scene_image, sun_grid = shadow_grid,
                       ao_work = ambient_occlusion, indirect = indirect, waves = wave_vertices },
                     frame, _, _, _, _, _))
  let (water_cells, water_draw) = cull_water(frame, terrain_cells)
  let water_triangles = rasterize_triangles(
    indirect_draw(water_draw),
    water.mesh_vertex(water_cells, wave_vertices, frame.resolution, camera_from_frame(frame), _, _, _))
  let image = shade_with(opaque_depth, opaque_image, water_triangles,
    water.mesh_fragment(scene_image, shadow_grid, reflected_scene, reflection_sampler, frame.resolution,
      camera_from_frame(frame), frame.time, _, _, _, _, _)) in

  (next_world.ui, next_world.points, next_world.items, next_world.head,
   next_occlusion, indirect, trace_nodes, radiance, rays, temporal,
   shadow_grid, scene_image, image, wave_vertices, wave_heights, reflected_scene)

-- Export the same caster boxes as the visible masonry, only when it changes.
-- Four records per slot: center/radius, then basis axis/half extent.
entry shadow_geometry(terrain_cells: []vec4f32) []vec4f32 =
  map(|i|
    let p = masonry_prop(terrain_cells, i / 4) in
    if i % 4 == 0 then @[p.center.x, p.center.y, p.center.z, p.radius]
    else if i % 4 == 1 then @[p.right.x, p.right.y, p.right.z, p.half.x]
    else if i % 4 == 2 then @[p.up.x, p.up.y, p.up.z, p.half.y]
    else @[p.fwd.x, p.fwd.y, p.fwd.z, p.half.z], iota((PROP_WALLS + banks.COUNT) * 4))

-- Diagnostic queries use precisely the same visibility function as rendering.
entry shadow_visibility(shadow_grid: []vec4f32, points: []vec4f32) []f32 =
  map(|p| sun_shadow(shadow_grid, p.xyz, @[0.0, 1.0, 0.0]), points)
