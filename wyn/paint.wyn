-- paint: the ground painter — item kinds, tool footprints, buffer capacities, the
-- tessellation budget, and the tessellation itself (item list -> flat triangle
-- ribbon). The generic spline/ribbon primitives live in wyn/curves; the online
-- capture fold lives in input.wyn; update_world consumes its emitted points.
--
-- The world is an ordered list of parametric items (the source of truth):
--   * water  (kind 1): a stroke (control-point polyline) swept by a big radius
--   * fence  (kind 2): a stroke swept by a small half-width
--   * building (kind 3): a single center point, fixed-size rectangle
-- Strokes capture control points online (Reumann-Witkam); ground_pos/ground_nrm
-- tessellate them into a flat triangle ribbon. Nothing is drawn above the ground.
--
-- Library module: no `open`; f32.* qualified (see math.wyn for the idiom).

import "pkg:curves"

-- Fixed painter capacities; generated output lengths size the driver buffers.
def POINTS_CAP: i32 = 1024     -- total control points across all items
def ITEMS_CAP:  i32 = 128      -- max items

-- Online capture tuning (world meters). Kept fine so a stroke tracks the cursor as
-- you drag (a coarse MAXCHORD makes a straight drag commit no points until release,
-- which reads as an unresponsive tool).
def STEP:     f32 = 0.15       -- min cursor travel to take a new raw sample
def CORRIDOR: f32 = 0.22       -- Reumann-Witkam perpendicular tolerance
def MAXCHORD: f32 = 0.6        -- force a control point on long, gentle arcs

-- Per-tool footprint.
def WATER_R:  f32 = 1.6        -- canal half-width (stored per water item as its param)
def FENCE_HW: f32 = 0.30       -- fence half-width (stored per item; widenable)
def BUILD_HX: f32 = 2.0        -- building half-extent x (4 m wide)
def BUILD_HZ: f32 = 1.5        -- building half-extent z (3 m deep)

def is_water(tool: f32) bool = tool < 0.5

def is_fence(tool: f32) bool = tool >= 0.5 && tool < 1.5

def is_building(tool: f32) bool = tool > 1.5

-- Tool codes are zero-based; item kind zero is reserved for an empty slot.
def item_kind_for_tool(tool: f32) f32 = tool + 1.0

-- Buildings use fixed rectangle dimensions, so their stroke width is unused.
def stroke_half_width(tool: f32) f32 =
  if is_water(tool) then WATER_R
  else if is_fence(tool) then FENCE_HW
  else 0.0

type paint_item = { kind: f32, point_start: i32, point_count: i32, param: f32 }

def paint_item_from_packed(v: vec4f32) paint_item =
  { kind = v.x, point_start = i32(v.y), point_count = i32(v.z), param = v.w }

def pack_paint_item(it: paint_item) vec4f32 =
  @[it.kind, f32(it.point_start), f32(it.point_count), it.param]

type ground_vertex = { pos: vec3f32, kind: f32, nrm: vec3f32, attr: f32 }

def ground_vertex_from_packed(pos: vec4f32, nrm: vec4f32) ground_vertex =
  { pos = pos.xyz, kind = pos.w,
    nrm = nrm.xyz, attr = nrm.w }

-- Rendering.
def GROUND_HALF: f32 = 20.0    -- half-size of the ground quad (40 m patch)
def CR_SUB:    i32 = 4         -- Catmull-Rom subsegments per control-point span

-- Tessellation budget: each item reserves space for its control-point spans.
-- Unused slots collapse to degenerate triangles.
def TESS_MAXCP: i32 = 32       -- max control points tessellated per item
def TESS_VPS:   i32 = CR_SUB * 6                      -- vertices per span
def TESS_VPI:   i32 = (TESS_MAXCP - 1) * TESS_VPS     -- vertices per item
def TESS_BASE:  i32 = 6        -- leading verts = the ground base quad (sand)
def TESS_CAP:   i32 = TESS_BASE + ITEMS_CAP * TESS_VPI

-- Triangle-list vertex of an axis-aligned 2D rectangle (vertex in [0,6)).
def rect_vertex(center: vec2f32, half_x: f32, half_y: f32,
                vertex: i32) vec2f32 =
  let offset =
    if vertex == 0 then @[0.0 - half_x, 0.0 - half_y]
    else if vertex == 1 then @[0.0 - half_x, half_y]
    else if vertex == 2 then @[half_x, half_y]
    else if vertex == 3 then @[0.0 - half_x, 0.0 - half_y]
    else if vertex == 4 then @[half_x, half_y]
    else @[half_x, 0.0 - half_y] in
  center + offset

-- Evaluate one ground vertex: the base quad, a building rectangle, or a stroke
-- ribbon. Inactive slots have zero positions; normals always point up.
def ground_vertex_at(vertex_index: i32, items: []vec4f32, points: []vec2f32) ground_vertex =
  let up = @[0.0, 1.0, 0.0]
  let empty = { pos = @[0.0, 0.0, 0.0], kind = 0.0, nrm = up, attr = 0.0 } in
  if vertex_index < TESS_BASE then
    let p = rect_vertex(@[0.0, 0.0], GROUND_HALF, GROUND_HALF, vertex_index) in
    { pos = @[p.x, 0.0, p.y], kind = 0.0, nrm = up, attr = 0.0 }
  else
    let item_vertex_index = vertex_index - TESS_BASE
    let vertex_in_item = item_vertex_index % TESS_VPI
    let item = paint_item_from_packed(items[item_vertex_index / TESS_VPI]) in
    if item.kind < 0.5 then empty
    else if item.kind > 2.5 then
      if vertex_in_item < 6 then
        let p = rect_vertex(points[item.point_start], BUILD_HX, BUILD_HZ, vertex_in_item) in
        { pos = @[p.x, 0.0, p.y], kind = item.kind, nrm = up, attr = 1.0 }
      else { pos = @[0.0, 0.0, 0.0], kind = 0.0, nrm = up, attr = 1.0 }
    else
      let span = vertex_in_item / TESS_VPS
      let subsegment = (vertex_in_item % TESS_VPS) / 6
      let corner = vertex_in_item % 6 in
      if span >= item.point_count - 1 then empty
      else
        let start = item.point_start
        let p1 = points[start + span]
        let p2 = points[start + span + 1]
        let p0 = if span > 0 then points[start + span - 1] else p1
        let p3 = if span + 2 < item.point_count then points[start + span + 2] else p2
        let u0 = f32(subsegment) / f32(CR_SUB)
        let u1 = f32(subsegment + 1) / f32(CR_SUB)
        let (position, edge) = curves.ribbon_vertex(p0, p1, p2, p3, u0, u1, item.param, corner) in
        { pos = @[position.x, 0.0, position.y], kind = item.kind, nrm = up, attr = edge }

-- Pack position/kind and normal/edge into the two render streams.
def ground_pos(vertex_index: i32, items: []vec4f32, points: []vec2f32) vec4f32 =
  let vertex = ground_vertex_at(vertex_index, items, points) in
  @[vertex.pos..., vertex.kind]

def ground_nrm(vertex_index: i32, items: []vec4f32, points: []vec2f32) vec4f32 =
  let vertex = ground_vertex_at(vertex_index, items, points) in
  @[vertex.nrm..., vertex.attr]
